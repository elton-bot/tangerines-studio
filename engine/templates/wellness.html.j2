{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{# Wellness theme. Calm, unhurried, clinical without being cold. Matches /work/northline-chiropractic/ #}
{% block fontpreload %}<link rel="preload" href="{{ root }}fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ root }}fonts/figtree.woff2" as="font" type="font/woff2" crossorigin>{% endblock %}
{% block css %}
@font-face{font-family:"Newsreader";src:url({{ root }}fonts/newsreader.woff2) format("woff2");font-weight:200 800;font-display:swap}
@font-face{font-family:"Figtree";src:url({{ root }}fonts/figtree.woff2) format("woff2");font-weight:300 900;font-display:swap}
:root{--bg:{{ p.bg }};--tint:{{ p.tint }};--ink:{{ p.ink }};--ink2:{{ p.ink2 }};--sage:{{ p.accent_text }};--line:{{ p.line }};--paper:{{ p.paper or "#FBFAF7" }};--main:{{ p.main }};--main2:{{ p.main2 }};--accent:{{ p.accent }}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;font-family:"Figtree",system-ui,sans-serif;font-size:1.0625rem;line-height:1.65;color:var(--ink);background:var(--bg)}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
:focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:3px}
.on-dark :focus-visible{outline-color:#fff}
.wrap{max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,64px)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:88px}
.brand{display:flex;align-items:center;gap:14px;text-decoration:none;min-width:0}
.brand svg{flex:none}
.brand .name{font-family:"Newsreader",serif;font-size:1.625rem;font-weight:500;letter-spacing:-.01em;line-height:1.05}
.brand .name i{font-style:normal;font-family:"Figtree",sans-serif;font-size:.75rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;display:block;margin-top:6px;color:var(--ink2)}
.brand .logo{height:56px;width:auto;max-width:260px;object-fit:contain}
nav.main ul{display:flex;gap:32px;list-style:none;margin:0;padding:0}
nav.main a{text-decoration:none;font-size:.9375rem;font-weight:500}
nav.main a:hover{text-decoration:underline;text-underline-offset:5px}
.top-cta{display:flex;align-items:center;gap:20px}
.top-cta .tel{font-weight:600;text-decoration:none;font-variant-numeric:tabular-nums;white-space:nowrap}
.btn{display:inline-flex;align-items:center;justify-content:center;font-weight:600;text-decoration:none;padding:14px 26px;border-radius:999px;font-size:1rem;line-height:1.2;white-space:nowrap}
.btn.dark{background:var(--main);color:var(--paper)}
.btn.dark:hover{background:var(--main2)}
.btn.line{border:1.5px solid var(--ink);color:var(--ink)}
.btn.line:hover{background:var(--ink);color:var(--paper)}
.hero{padding:clamp(40px,6vw,88px) 0 clamp(64px,8vw,120px)}
.hero-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(32px,6vw,96px);align-items:end}
.eyebrow{display:flex;align-items:center;gap:12px;font-size:.875rem;font-weight:600;color:var(--sage);margin:0 0 28px}
.eyebrow:before{content:"";flex:none;width:40px;height:1px;background:var(--sage)}
h1,h2{font-family:"Newsreader",serif;font-weight:400;letter-spacing:-.02em}
h1{font-size:clamp(2.7rem,6vw,5.25rem);line-height:1.02;margin:0 0 32px}
h1.mid{font-size:clamp(2.4rem,4.8vw,4.25rem);line-height:1.05}
h1.long{font-size:clamp(2.1rem,3.9vw,3.4rem);line-height:1.08}
.lede{font-size:1.1875rem;max-width:44ch;color:var(--ink2);margin:0 0 36px}
.actions{display:flex;flex-wrap:wrap;gap:12px}
.hero-photo{margin:0}
.hero-photo img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:{{ b.hero_image_position or "50% 40%" }};border-radius:220px 220px 6px 6px}
.arch{background:var(--tint);border-radius:220px 220px 6px 6px;padding:clamp(88px,10vw,128px) clamp(28px,3.5vw,48px) clamp(32px,3.5vw,44px);position:relative}
.arch:before{content:"";position:absolute;left:50%;top:30px;width:1px;height:46px;background:var(--sage)}
.arch .label{font-size:.8125rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--sage);margin:0 0 6px;text-align:center}
.arch .tel{display:block;text-align:center;font-family:"Newsreader",serif;font-size:clamp(1.9rem,3vw,2.5rem);text-decoration:none;font-variant-numeric:lining-nums tabular-nums;margin-bottom:24px;overflow-wrap:anywhere}
.arch dl{margin:0;border-top:1px solid #AEB9B4}
.arch dl div{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid #AEB9B4;font-size:.98rem}
.arch dt{color:var(--ink2)}.arch dd{margin:0;font-weight:600;text-align:right}
.arch ul{list-style:none;margin:0;padding:0;border-top:1px solid #AEB9B4}
.arch li{padding:12px 0;border-bottom:1px solid #AEB9B4;font-family:"Newsreader",serif;font-size:1.25rem;text-align:center}
section{padding:clamp(72px,9vw,128px) 0}
h2{font-size:clamp(2.1rem,4vw,3.4rem);line-height:1.06;margin:0 0 20px}
.intro{max-width:46ch;color:var(--ink2);margin:0}
.facts{background:var(--tint)}
.facts ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat({{ b.facts|length or 1 }},minmax(0,1fr));gap:clamp(24px,4vw,56px)}
.facts li{border-top:1px solid #AEB9B4;padding-top:22px}
.facts .n{display:block;font-family:"Newsreader",serif;font-style:italic;color:var(--sage);margin-bottom:6px}
.facts b{display:block;font-family:"Newsreader",serif;font-weight:500;font-size:1.5rem;line-height:1.25}
.svc-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,7vw,112px)}
.svc-list{list-style:none;margin:0;padding:0}
.svc-list li{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:24px;padding:26px 0;border-bottom:1px solid var(--line)}
.svc-list li:first-child{border-top:1px solid var(--line)}
.svc-list h3{font-family:"Newsreader",serif;font-weight:500;font-size:1.5rem;line-height:1.2;margin:0;letter-spacing:-.01em}
.svc-list p{margin:0;color:var(--ink2)}
.quotes-sec{background:var(--tint)}
.quotes{list-style:none;margin:48px 0 0;padding:0;display:grid;grid-template-columns:repeat({{ [b.reviews|length, 3]|min }},minmax(0,1fr));gap:clamp(24px,4vw,56px)}
.quotes li{border-top:1px solid #AEB9B4;padding-top:24px}
.quotes blockquote{margin:0;font-family:"Newsreader",serif;font-size:1.375rem;line-height:1.45}
.quotes blockquote p{margin:0}
.quotes cite{display:block;font-style:normal;font-weight:600;margin-top:16px;font-size:.9375rem}
.src{font-size:.9375rem;color:var(--ink2);margin:36px 0 0}
.doc{background:var(--paper)}
.doc-grid{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(32px,7vw,112px);align-items:center}
.doc-grid.solo{grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:start}
.doc img{width:100%;aspect-ratio:16/11;object-fit:cover;border-radius:6px}
.doc p{max-width:52ch;margin:0 0 18px}
.doc .lead{font-family:"Newsreader",serif;font-size:1.5rem;line-height:1.4;max-width:40ch}
.visit-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(32px,7vw,112px)}
.visit-grid.one{grid-template-columns:minmax(0,1fr);max-width:720px}
dl.hours{margin:28px 0 0;border-top:1px solid var(--line)}
dl.hours div{display:flex;justify-content:space-between;gap:16px;padding:16px 0;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}
dl.hours dt{font-weight:600}dl.hours dd{margin:0;color:var(--ink2);text-align:right}
.area{margin:28px 0 0;font-family:"Newsreader",serif;font-size:1.375rem;line-height:1.5}
address{font-style:normal;font-family:"Newsreader",serif;font-size:1.75rem;line-height:1.3;margin:0 0 24px}
dl.contact-list{margin:0;border-top:1px solid var(--line)}
dl.contact-list div{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid var(--line)}
dl.contact-list dt{color:var(--ink2)}
dl.contact-list dd{margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere;min-width:0}
.req{background:var(--main);color:var(--paper)}
.req-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,7vw,112px)}
.req .intro{color:#C9D3D1}
.req .bigtel{display:inline-block;margin-top:28px;font-family:"Newsreader",serif;font-size:clamp(2rem,3.6vw,2.75rem);text-decoration:none;font-variant-numeric:lining-nums tabular-nums}
.req .bigtel:hover{text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:1px}
.req .mail{display:block;margin-top:12px;overflow-wrap:anywhere}
form{background:var(--bg);color:var(--ink);border-radius:10px;padding:clamp(24px,3.5vw,44px)}
.note{background:var(--tint);border-radius:6px;padding:12px 16px;font-size:.9375rem;margin:0 0 24px}
fieldset{border:0;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:18px;min-width:0}
label{display:block;font-weight:600;font-size:.9375rem}
.full{grid-column:1/-1}
input,select,textarea{display:block;width:100%;margin-top:6px;font:inherit;font-size:1rem;padding:12px 14px;border:1px solid #98A5A1;border-radius:6px;background:#EEF0EE;color:var(--ink)}
textarea{min-height:110px}
form button{margin-top:22px;font:inherit;font-weight:600;background:var(--main);color:var(--paper);border:0;border-radius:999px;padding:14px 26px;cursor:pointer}
form button:hover{background:var(--main2)}
form button[disabled]{background:#6B7679;color:#fff;cursor:not-allowed}
.form-done{background:var(--bg);color:var(--ink);border-radius:10px;padding:clamp(24px,3.5vw,44px)}
.form-done p{margin:0 0 8px}
.page-hero{padding-bottom:clamp(40px,5vw,72px)}
.page-hero h1{max-width:18ch}
.prose{max-width:860px}
.prose.with-img{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(32px,7vw,112px);max-width:none;align-items:center}
.prose p{max-width:60ch;margin:0 0 18px}
.prose .svc-list{margin-top:28px}
.prose-img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:6px}
.prose-sec+.prose-sec{padding-top:0}
.gallery{list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.gallery img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:6px}
footer{padding:48px 0 56px;font-size:.9375rem;color:var(--ink2)}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px;border-top:1px solid var(--line);padding-top:32px}
.foot p{margin:0}
.callbar{display:none}
@media (max-width:1000px){
  nav.main{display:none}
  .hero-grid,.svc-grid,.doc-grid,.doc-grid.solo,.visit-grid,.req-grid,.prose.with-img{grid-template-columns:1fr}
  .gallery{grid-template-columns:1fr 1fr}
  .hero-photo,.arch{max-width:520px}
  .facts ul,.quotes{grid-template-columns:1fr}
}
@media (max-width:760px){
  .bar{min-height:72px}
  .top-cta{display:none}
  .brand .name{font-size:1.375rem}
  .brand .logo{height:46px;max-width:210px}
  .hero-photo img{aspect-ratio:1/1;border-radius:160px 160px 6px 6px}
  .arch{border-radius:160px 160px 6px 6px}
  .svc-list li{grid-template-columns:1fr;gap:6px}
  fieldset{grid-template-columns:1fr}
  .callbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:20;gap:10px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:var(--bg);border-top:1px solid var(--line)}
  .callbar .btn{flex:1;padding:14px 12px}
  footer{padding-bottom:110px}
}
{% endblock %}
{% block body %}
{% set contact_href = contact_href or "#contact" %}
{% macro sec_services() %}
  <section id="services" aria-labelledby="care-title">
    <div class="wrap svc-grid">
      <div>
        <h2 id="care-title">{{ b.services_title or "How we can help" }}</h2>
        {% if b.services_intro %}<p class="intro">{{ b.services_intro }}</p>{% endif %}
      </div>
      <ul class="svc-list">
        {% for s in b.services %}<li><h3>{{ s.name }}</h3>{% if s.text %}<p>{{ s.text }}</p>{% endif %}</li>{% endfor %}
      </ul>
    </div>
  </section>

{% endmacro %}
{% macro sec_about() %}
  <section id="about" class="doc" aria-labelledby="about-title">
    <div class="wrap doc-grid{% if not b.about_image_url %} solo{% endif %}">
      {% if b.about_image_url %}{{ m.img(b.about_image_url, b.about_image_alt or ("Photo from " ~ b.business_name), "(max-width:1000px) 90vw, 50vw", root=root) }}{% endif %}
      <div>
        <p class="eyebrow">About us</p>
        <h2 id="about-title">{{ b.about_title or ("About " ~ b.business_name) }}</h2>
        {% if not b.about_image_url %}</div><div>{% endif %}
        {% for para in b.about %}<p{% if loop.first and not b.about_image_url %} class="lead"{% endif %}>{{ para }}</p>{% endfor %}
      </div>
    </div>
  </section>

{% endmacro %}
{% macro sec_reviews() %}
  {% if b.reviews %}
  <section class="quotes-sec" aria-labelledby="rev-title">
    <div class="wrap">
      <h2 id="rev-title">{{ b.reviews_title or "In our patients' words" }}</h2>
      <ul class="quotes">
        {% for r in b.reviews %}<li><blockquote><p>&ldquo;{{ r.quote }}&rdquo;</p></blockquote><cite>{{ r.name }}</cite></li>{% endfor %}
      </ul>
      <p class="src">Quoted word for word from {{ b.reviews_source }}.</p>
    </div>
  </section>
  {% endif %}

{% endmacro %}
{% macro sec_visit() %}
  {% if b.hours or b.address or b.service_area %}
  <section id="visit" aria-labelledby="visit-title">
    <div class="wrap visit-grid{% if not (b.hours and b.address) %} one{% endif %}">
      {% if b.hours or b.service_area %}
      <div>
        <h2 id="visit-title">{% if b.hours %}Hours{% else %}Where we work{% endif %}</h2>
        {% if b.hours_note %}<p class="intro">{{ b.hours_note }}</p>{% endif %}
        {% if b.hours %}<dl class="hours">{% for h in b.hours %}<div><dt>{{ h.days }}</dt><dd>{{ h.time }}</dd></div>{% endfor %}</dl>{% endif %}
        {% if b.service_area %}<p class="area">Serving {{ b.service_area | join(", ") }}</p>{% endif %}
      </div>
      {% endif %}
      {% if b.address %}
      <div>
        {% if b.hours or b.service_area %}<h2>Find us</h2>{% else %}<h2 id="visit-title">Find us</h2>{% endif %}
        <address>{{ b.business_name }}<br>{{ b.address }}</address>
        <dl class="contact-list">
          {% if b.phone %}<div><dt>Phone</dt><dd><a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a></dd></div>{% endif %}
          {% if b.email %}<div><dt>Email</dt><dd><a href="mailto:{{ b.email }}">{{ b.email }}</a></dd></div>{% endif %}
          {% if b.map_url %}<div><dt>Directions</dt><dd><a href="{{ b.map_url }}" rel="noopener">Open in maps</a></dd></div>{% endif %}
        </dl>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

{% endmacro %}
{% macro sec_contact() %}
  <section id="contact" class="req on-dark" aria-labelledby="req-title">
    <div class="wrap req-grid">
      <div>
        <h2 id="req-title">{{ b.contact_title or "Get in touch" }}</h2>
        <p class="intro">{{ b.contact_text or ("Call or send a request." if b.phone else "Send an email or a request.") }}</p>
        {% if b.phone %}<a class="bigtel" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>{% endif %}
        {% if b.email %}<a class="mail" href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}
      </div>
      {% if mode == "preview" or b.form != false %}<div class="form-wrap">{{ m.form(b, mode, "note", "Appointment request", service_label="What would you like help with?", message_label="Anything we should know?") }}</div>{% endif %}
    </div>
  </section>
{% endmacro %}
{% macro sec_text(s) %}
  <section class="prose-sec" aria-labelledby="t-{{ s.id }}">
    <div class="wrap"><div class="prose{% if s.image %} with-img{% endif %}">
      <div>
        {% if s.label %}<p class="eyebrow">{{ s.label }}</p>{% endif %}
        <h2 id="t-{{ s.id }}">{{ s.heading }}</h2>
        {% for para in s.paragraphs or [] %}<p>{{ para }}</p>{% endfor %}
        {% if s.get("items") %}<ul class="svc-list">{% for it in s.get("items") %}<li><h3>{{ it.name }}</h3>{% if it.text %}<p>{{ it.text }}</p>{% endif %}</li>{% endfor %}</ul>{% endif %}
      </div>
      {% if s.image %}<div>{{ m.img(s.image, s.image_alt or ("Photo from " ~ b.business_name), "(max-width:1000px) 90vw, 45vw", root=root, cls="prose-img") }}</div>{% endif %}
    </div></div>
  </section>
{% endmacro %}
{% macro sec_gallery(s) %}
  <section class="gallery-sec" aria-labelledby="g-{{ s.id }}">
    <div class="wrap">
      <h2 id="g-{{ s.id }}">{{ s.heading or "Our practice" }}</h2>
      {% if s.intro %}<p class="intro">{{ s.intro }}</p>{% endif %}
      <ul class="gallery">{% for g in s.images %}<li>{{ m.img(g, g.alt or ("Photo from " ~ b.business_name), "(max-width:760px) 90vw, 33vw", root=root) }}</li>{% endfor %}</ul>
    </div>
  </section>
{% endmacro %}
<header>
  <div class="wrap bar">
    <a class="brand" href="{{ home_href or '#main' }}">
      {% if b.logo_url %}
      <img class="logo" src="{{ root }}{{ b.logo_url.src }}" width="{{ b.logo_url.width }}" height="{{ b.logo_url.height }}" alt="{{ b.business_name }}{% if page %}, home{% endif %}">
      {% else %}
      <svg width="30" height="48" viewBox="0 0 30 48" aria-hidden="true"><path d="M15 2v44" stroke="{{ p.ink }}" stroke-width="1.5"/><circle cx="15" cy="9" r="5" fill="none" stroke="{{ p.ink }}" stroke-width="1.5"/><path d="M9 22h12M10 30h10M11 38h8" stroke="{{ p.accent_text }}" stroke-width="1.5"/></svg>
      <span class="name">{{ b.wm_main }}{% if b.wm_sub %}<i>{{ b.wm_sub }}</i>{% endif %}</span>
      {% endif %}
    </a>
    <nav class="main" aria-label="Main"><ul>{% for n in nav %}<li><a href="{{ n.href }}"{% if n.current %} aria-current="page"{% endif %}>{{ n.label }}</a></li>{% endfor %}</ul></nav>
    <div class="top-cta">{% if b.phone %}<a class="tel" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>{% endif %}<a class="btn dark" href="{{ contact_href }}">{{ b.cta_label or "Request a visit" }}</a></div>
  </div>
</header>
<main id="main">
  {% if page %}
  <section class="hero page-hero" aria-labelledby="hero-title">
    <div class="wrap">
      {% if page.label %}<p class="eyebrow">{{ page.label }}</p>{% endif %}
      <h1 id="hero-title">{{ page.heading or page.title }}</h1>
      {% if page.intro %}<p class="lede">{{ page.intro }}</p>{% endif %}
    </div>
  </section>
  {% for s in page.sections %}
  {% if s.type == "services" %}{{ sec_services() }}{% elif s.type == "about" %}{{ sec_about() }}{% elif s.type == "reviews" %}{{ sec_reviews() }}{% elif s.type == "visit" %}{{ sec_visit() }}{% elif s.type == "contact" %}{{ sec_contact() }}{% elif s.type == "gallery" %}{{ sec_gallery(s) }}{% else %}{{ sec_text(s) }}{% endif %}
  {% endfor %}
  {% else %}
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        {% if b.kicker or b.city %}<p class="eyebrow">{{ b.kicker or b.city }}</p>{% endif %}
        <h1 id="hero-title" class="{{ b.title_size }}">{{ b.hero_title }}</h1>
        <p class="lede">{{ b.hero_sub }}</p>
        <div class="actions">
          {% if b.phone %}<a class="btn dark" href="tel:{{ b.phone_digits }}">Call {{ b.phone }}</a>{% endif %}
          <a class="btn {{ 'line' if b.phone else 'dark' }}" href="{{ contact_href }}">{{ b.cta_label or "Send a request" }}</a>
        </div>
      </div>
      {% if b.hero_image_url %}
      <figure class="hero-photo">{{ m.img(b.hero_image_url, b.hero_image_alt or ("Photo from " ~ b.business_name), "(max-width:1000px) 90vw, 40vw", eager=True, root=root) }}</figure>
      {% else %}
      <div class="arch">
        {% if b.phone %}<p class="label">Call to book</p><a class="tel" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>
        {% else %}<p class="label">Email us</p><a class="tel" style="font-size:1.375rem" href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}
        {% if b.hours %}<dl>{% for h in b.hours[:5] %}<div><dt>{{ h.days }}</dt><dd>{{ h.time }}</dd></div>{% endfor %}</dl>
        {% elif b.facts %}<ul>{% for f in b.facts %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
      </div>
      {% endif %}
    </div>
  </section>

  {% if b.facts %}
  <div class="facts">
    <section style="padding:clamp(48px,6vw,80px) 0" aria-label="At a glance">
      <div class="wrap"><ul>{% for f in b.facts %}<li><span class="n">{{ ["One", "Two", "Three", "Four"][loop.index0] }}</span><b>{{ f }}</b></li>{% endfor %}</ul></div>
    </section>
  </div>
  {% endif %}

  {{ sec_services() }}
  {{ sec_about() }}
  {{ sec_reviews() }}
  {{ sec_visit() }}
  {{ sec_contact() }}
  {% endif %}
</main>
<footer>
  <div class="wrap foot">
    <p>{{ b.business_name }}{% if b.address %}<br>{{ b.address }}{% endif %}</p>
    <p>{% if b.phone %}<a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a><br>{% endif %}{% if b.email %}<a href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}</p>
    <p>{{ m.footer_credit(b, mode) }}</p>
  </div>
</footer>
<div class="callbar">
  {% if b.phone %}<a class="btn dark" href="tel:{{ b.phone_digits }}">Call {{ b.phone }}</a>{% endif %}
  <a class="btn {{ 'line' if b.phone else 'dark' }}" href="{{ contact_href }}">{{ "Request" if b.phone else "Contact" }}</a>
</div>
{% endblock %}
