{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{# Personal theme for coaches and speakers. Editorial and confident: warm white, near-black ink, a lavender signature.
   Matches /work/maya-okafor/. Booking and book buttons always link out to the page the person already uses. #}
{% block fontpreload %}<link rel="preload" href="{{ root }}fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ root }}fonts/hanken-grotesk.woff2" as="font" type="font/woff2" crossorigin>{% endblock %}
{% block css %}
@font-face{font-family:"Bricolage Grotesque";src:url({{ root }}fonts/bricolage-grotesque.woff2) format("woff2");font-weight:200 800;font-display:swap}
@font-face{font-family:"Hanken Grotesk";src:url({{ root }}fonts/hanken-grotesk.woff2) format("woff2");font-weight:100 900;font-display:swap}
:root{--bg:{{ p.bg }};--tint:{{ p.tint }};--ink:{{ p.ink }};--ink2:{{ p.ink2 }};--violet:{{ p.accent_text }};--line:{{ p.line }};--main:{{ p.main }};--main2:{{ p.main2 }};--accent:{{ p.accent }};--muted:{{ p.on_main_muted or "#B9B3C2" }}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;font-family:"Hanken Grotesk",system-ui,sans-serif;font-size:1.0625rem;line-height:1.65;color:var(--ink);background:var(--bg)}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-underline-offset:.2em}
:focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:3px}
.on-dark :focus-visible{outline-color:#fff}
.wrap{max-width:1240px;margin:0 auto;padding:0 clamp(20px,5vw,64px)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:84px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;min-width:0}
.brand .mono{flex:none;display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--accent);color:var(--main);font-family:"Bricolage Grotesque",sans-serif;font-weight:700;font-size:.9375rem;letter-spacing:.02em}
.brand .name{font-family:"Bricolage Grotesque",sans-serif;font-size:1.3125rem;font-weight:700;letter-spacing:-.025em;line-height:1.05}
.brand .name i{font-style:normal;font-family:"Hanken Grotesk",sans-serif;font-size:.8125rem;font-weight:500;letter-spacing:0;display:block;margin-top:3px;color:var(--ink2)}
.brand .logo{height:52px;width:auto;max-width:240px;object-fit:contain}
nav.main ul{display:flex;gap:28px;list-style:none;margin:0;padding:0}
nav.main a{text-decoration:none;font-size:.9375rem;font-weight:500}
nav.main a:hover,nav.main a[aria-current]{text-decoration:underline;text-decoration-thickness:2px;text-decoration-color:var(--violet)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:600;text-decoration:none;padding:14px 24px;border-radius:999px;font-size:1rem;line-height:1.2;white-space:nowrap}
.btn.dark{background:var(--main);color:#fff}
.btn.dark:hover{background:var(--main2)}
.btn.line{border:1.5px solid var(--ink);color:var(--ink)}
.btn.line:hover{background:var(--ink);color:#fff}
.btn.lav{background:var(--accent);color:var(--main)}
.btn.lav:hover{background:#fff}
.btn .out{font-size:.875em;line-height:1}
.hero{padding:clamp(32px,5vw,72px) 0 clamp(64px,8vw,112px)}
.hero-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(32px,6vw,96px);align-items:center}
.eyebrow{font-size:.875rem;font-weight:600;color:var(--violet);margin:0 0 22px;letter-spacing:.01em}
h1,h2,h3{font-family:"Bricolage Grotesque",sans-serif;letter-spacing:-.035em}
h1{font-weight:700;font-size:clamp(2.75rem,6vw,5.5rem);line-height:.98;margin:0 0 28px}
h1.mid{font-size:clamp(2.4rem,4.8vw,4.3rem);line-height:1.02}
h1.long{font-size:clamp(2.1rem,3.8vw,3.4rem);line-height:1.06}
.lede{font-size:1.1875rem;max-width:42ch;color:var(--ink2);margin:0 0 34px}
.actions{display:flex;flex-wrap:wrap;gap:12px}
.portrait{margin:0;position:relative;padding:0 0 22px 22px}
.portrait:before{content:"";position:absolute;left:0;bottom:0;width:78%;height:82%;background:var(--accent);border-radius:24px}
.portrait img{position:relative;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:{{ b.hero_image_position or "50% 30%" }};border-radius:24px}
.hero.type{background:var(--main);color:#fff;padding:clamp(56px,8vw,120px) 0;position:relative;overflow:hidden}
.hero.type .eyebrow{color:var(--accent)}
.hero.type .lede{color:var(--muted)}
.hero.type .big-mono{position:absolute;right:-2vw;bottom:-6vw;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(14rem,30vw,28rem);line-height:.8;letter-spacing:-.06em;color:transparent;-webkit-text-stroke:1.5px rgba(201,184,236,.35);pointer-events:none;user-select:none}
.hero.type .hero-grid{position:relative}
.cred-panel{border-top:1px solid #4A4552;padding-top:20px}
.cred-panel h2{font-size:.875rem;font-family:"Hanken Grotesk",sans-serif;font-weight:600;letter-spacing:.01em;color:var(--accent);margin:0 0 10px}
.cred-panel ul{list-style:none;margin:0;padding:0}
.cred-panel li{padding:12px 0;border-bottom:1px solid #4A4552;font-weight:500}
section{padding:clamp(72px,9vw,128px) 0}
h2{font-weight:700;font-size:clamp(2.1rem,4.2vw,3.5rem);line-height:1.02;margin:0 0 18px}
.intro{max-width:48ch;color:var(--ink2);margin:0}
.creds{background:var(--main);color:#fff}
.creds ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:12px 0;justify-content:center}
.creds li{font-family:"Bricolage Grotesque",sans-serif;font-size:clamp(1.0625rem,1.6vw,1.3125rem);font-weight:600;letter-spacing:-.01em;display:flex;align-items:center}
.creds li+li:before{content:"";width:7px;height:7px;border-radius:50%;background:var(--accent);margin:0 clamp(16px,2.4vw,32px)}
.offer-head{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,6vw,96px);align-items:end;margin-bottom:48px}
.offers{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}
.offers li{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(16px,6vw,96px);padding:30px 0;border-bottom:1px solid var(--line)}
.offers h3{font-size:clamp(1.5rem,2.4vw,2rem);font-weight:700;line-height:1.1;margin:0}
.offers p{margin:0;color:var(--ink2);max-width:56ch}
.talks{background:var(--tint)}
.talk-list{list-style:none;margin:44px 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,2.4vw,28px)}
.talk-list li{background:#fff;border-radius:20px;padding:clamp(24px,3vw,36px)}
.talk-list .k{display:block;font-size:.8125rem;font-weight:600;color:var(--violet);margin-bottom:12px}
.talk-list h3{font-size:clamp(1.375rem,2vw,1.75rem);font-weight:700;line-height:1.12;margin:0 0 10px}
.talk-list p{margin:0;color:var(--ink2)}
.book-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,7vw,112px);align-items:center}
.cover{margin:0 auto;width:min(100%,340px);aspect-ratio:2/3;border-radius:4px 14px 14px 4px;background:var(--main);color:#fff;padding:12% 11%;display:flex;flex-direction:column;justify-content:space-between;box-shadow:-10px 0 0 -4px #3A3542 inset,0 40px 60px -30px rgba(25,23,28,.6);position:relative;overflow:hidden}
.cover:after{content:"";position:absolute;right:-30%;top:34%;width:90%;aspect-ratio:1;border-radius:50%;background:var(--accent);opacity:.9}
.cover b{position:relative;z-index:1;font-family:"Bricolage Grotesque",sans-serif;font-weight:700;font-size:clamp(1.75rem,3vw,2.375rem);line-height:1;letter-spacing:-.035em}
.cover span{position:relative;z-index:1;font-size:.875rem;font-weight:600;letter-spacing:.02em}
.cover-img{margin:0 auto;width:min(100%,340px);height:auto;border-radius:4px;box-shadow:0 40px 60px -30px rgba(25,23,28,.6)}
.book .sub{font-family:"Bricolage Grotesque",sans-serif;font-size:1.375rem;line-height:1.3;font-weight:500;letter-spacing:-.015em;margin:0 0 18px;color:var(--ink2)}
.book p{max-width:54ch;margin:0 0 18px}
.book .actions{margin-top:28px}
.about-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,7vw,112px);align-items:center}
.about-grid.solo{grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:start}
.about-img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:24px}
.about p{margin:0 0 18px;max-width:56ch}
.about p.lead{font-family:"Bricolage Grotesque",sans-serif;font-size:1.5rem;line-height:1.35;letter-spacing:-.02em;font-weight:500}
.quotes-sec{background:var(--bg);border-top:1px solid var(--line)}
.quotes{list-style:none;margin:44px 0 0;padding:0;display:grid;grid-template-columns:repeat({{ [b.reviews|length, 3]|min }},minmax(0,1fr));gap:clamp(24px,4vw,48px)}
.quotes li{border-top:2px solid var(--ink);padding-top:22px}
.quotes blockquote{margin:0;font-size:1.25rem;line-height:1.5}
.quotes blockquote p{margin:0}
.quotes cite{display:block;font-style:normal;font-weight:600;margin-top:14px;font-size:.9375rem}
.src{font-size:.9375rem;color:var(--ink2);margin:32px 0 0}
.visit-grid{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:clamp(32px,7vw,112px)}
.visit-grid.one{grid-template-columns:minmax(0,1fr);max-width:720px}
dl.hours{margin:24px 0 0;border-top:2px solid var(--ink)}
dl.hours div{display:flex;justify-content:space-between;gap:16px;padding:15px 0;border-bottom:1px solid var(--line)}
dl.hours dt{font-weight:600}dl.hours dd{margin:0;color:var(--ink2);text-align:right}
.area{margin:24px 0 0;font-size:1.25rem}
address{font-style:normal;font-size:1.375rem;line-height:1.4;margin:0 0 24px}
dl.contact-list{margin:0;border-top:1px solid var(--line)}
dl.contact-list div{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid var(--line)}
dl.contact-list dt{color:var(--ink2)}
dl.contact-list dd{margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere;min-width:0}
.req{background:var(--main);color:#fff}
.req-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,7vw,112px)}
.req h2{font-size:clamp(2.4rem,5vw,4.25rem)}
.req .intro{color:var(--muted)}
.req .actions{margin-top:32px}
.req .mail{display:block;margin-top:20px;overflow-wrap:anywhere;font-weight:600}
.req .tel{display:block;margin-top:8px;font-weight:600}
form{background:var(--bg);color:var(--ink);border-radius:24px;padding:clamp(24px,3.5vw,44px)}
.note{background:var(--tint);border-radius:12px;padding:12px 16px;font-size:.9375rem;margin:0 0 24px}
fieldset{border:0;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:18px;min-width:0}
label{display:block;font-weight:600;font-size:.9375rem}
.full{grid-column:1/-1}
input,select,textarea{display:block;width:100%;margin-top:6px;font:inherit;font-size:1rem;padding:12px 14px;border:1px solid #A39DAB;border-radius:10px;background:#F1EEF4;color:var(--ink)}
textarea{min-height:110px}
form button{margin-top:22px;font:inherit;font-weight:600;background:var(--main);color:#fff;border:0;border-radius:999px;padding:14px 24px;cursor:pointer}
form button:hover{background:var(--main2)}
form button[disabled]{background:#6E6A75;color:#fff;cursor:not-allowed}
.form-done{background:var(--bg);color:var(--ink);border-radius:24px;padding:clamp(24px,3.5vw,44px)}
.form-done p{margin:0 0 8px}
.page-hero{padding-bottom:clamp(40px,5vw,72px)}
.page-hero h1{max-width:18ch}
.prose{max-width:860px}
.prose.with-img{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(32px,7vw,112px);max-width:none;align-items:center}
.prose p{max-width:60ch;margin:0 0 18px}
.prose .offers{margin-top:28px}
.prose .offers li{grid-template-columns:1fr;gap:6px}
.prose-img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:24px}
.prose-sec+.prose-sec{padding-top:0}
.gallery{list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.gallery img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:16px}
footer{padding:48px 0 56px;font-size:.9375rem;color:var(--ink2)}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px;border-top:1px solid var(--line);padding-top:32px}
.foot p{margin:0}
.callbar{display:none}
@media (max-width:1000px){
  nav.main{display:none}
  .hero-grid,.offer-head,.book-grid,.about-grid,.about-grid.solo,.visit-grid,.req-grid,.prose.with-img{grid-template-columns:1fr}
  .portrait{max-width:520px}
  .talk-list,.quotes{grid-template-columns:1fr}
  .gallery{grid-template-columns:1fr 1fr}
  .about-img{max-width:520px}
}
@media (max-width:760px){
  .bar{min-height:72px}
  .top-cta{display:none}
  .brand .name{font-size:1.1875rem}
  .brand .logo{height:44px;max-width:200px}
  .portrait{padding:0 0 14px 14px}
  .portrait img{aspect-ratio:1/1}
  .cover,.cover-img{width:min(64%,230px)}
  .offers li{grid-template-columns:1fr;gap:8px}
  .creds ul{justify-content:flex-start;flex-direction:column;gap:10px}
  .creds li+li:before{display:none}
  .creds li:before,.creds li+li:before{content:"";display:block;width:7px;height:7px;border-radius:50%;background:var(--accent);margin:0 14px 0 0}
  fieldset{grid-template-columns:1fr}
  .callbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:20;gap:10px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:var(--bg);border-top:1px solid var(--line)}
  .callbar .btn{flex:1;padding:14px 10px}
  footer{padding-bottom:110px}
}
{% endblock %}
{% block body %}
{% set contact_href = contact_href or "#contact" %}
{% macro out(url, label, cls) %}<a class="btn {{ cls }}" href="{{ url }}" rel="noopener">{{ label }}<span class="out" aria-hidden="true">&#8599;</span></a>{% endmacro %}
{% macro book_btn(cls) %}{% if b.booking_url %}{{ out(b.booking_url, b.booking_label or "Book a call", cls) }}{% else %}<a class="btn {{ cls }}" href="{{ contact_href }}">{{ b.cta_label or "Get in touch" }}</a>{% endif %}{% endmacro %}
{% macro sec_services() %}
  <section id="services" aria-labelledby="offer-title">
    <div class="wrap">
      <div class="offer-head">
        <div>
          <p class="eyebrow">{{ b.services_label or b.services_nav }}</p>
          <h2 id="offer-title">{{ b.services_title or "How I can help" }}</h2>
        </div>
        {% if b.services_intro %}<p class="intro">{{ b.services_intro }}</p>{% endif %}
      </div>
      <ul class="offers">
        {% for s in b.services %}<li><h3>{{ s.name }}</h3>{% if s.text %}<p>{{ s.text }}</p>{% endif %}</li>{% endfor %}
      </ul>
    </div>
  </section>

{% endmacro %}
{% macro sec_talks() %}
  {% if b.talks %}
  <section id="talks" class="talks" aria-labelledby="talks-title">
    <div class="wrap">
      <p class="eyebrow">{{ b.talks_label or "Speaking" }}</p>
      <h2 id="talks-title">{{ b.talks_title or "Talks and topics" }}</h2>
      {% if b.talks_intro %}<p class="intro">{{ b.talks_intro }}</p>{% endif %}
      <ul class="talk-list">
        {% for t in b.talks %}<li>{% if t.kind %}<span class="k">{{ t.kind }}</span>{% endif %}<h3>{{ t.name }}</h3>{% if t.text %}<p>{{ t.text }}</p>{% endif %}</li>{% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

{% endmacro %}
{% macro sec_book() %}
  {% if b.book %}
  <section id="book" class="book" aria-labelledby="book-title">
    <div class="wrap book-grid">
      {% if b.book_image_url %}{{ m.img(b.book_image_url, "Cover of " ~ b.book.title, "(max-width:1000px) 80vw, 340px", root=root, cls="cover-img") }}
      {% else %}<div class="cover" role="img" aria-label="Cover of {{ b.book.title }}"><b>{{ b.book.title }}</b><span>{{ b.book.author or b.business_name }}</span></div>{% endif %}
      <div>
        <p class="eyebrow">{{ b.book.label or "The book" }}</p>
        <h2 id="book-title">{{ b.book.title }}</h2>
        {% if b.book.subtitle %}<p class="sub">{{ b.book.subtitle }}</p>{% endif %}
        {% for para in ([b.book.text] if b.book.text is string else (b.book.text or [])) %}<p>{{ para }}</p>{% endfor %}
        {% if b.book.url %}<div class="actions">{{ out(b.book.url, b.book.url_label or "Get the book", "dark") }}</div>{% endif %}
      </div>
    </div>
  </section>
  {% endif %}

{% endmacro %}
{% macro sec_about() %}
  <section id="about" class="about" aria-labelledby="about-title">
    <div class="wrap about-grid{% if not b.about_image_url %} solo{% endif %}">
      {% if b.about_image_url %}{{ m.img(b.about_image_url, b.about_image_alt or ("Photo of " ~ b.business_name), "(max-width:1000px) 90vw, 40vw", root=root, cls="about-img") }}{% endif %}
      <div>
        <p class="eyebrow">About</p>
        <h2 id="about-title">{{ b.about_title or ("About " ~ b.business_name) }}</h2>
        {% if not b.about_image_url %}</div><div>{% endif %}
        {% for para in b.about %}<p{% if loop.first %} class="lead"{% endif %}>{{ para }}</p>{% endfor %}
      </div>
    </div>
  </section>

{% endmacro %}
{% macro sec_reviews() %}
  {% if b.reviews %}
  <section class="quotes-sec" aria-labelledby="rev-title">
    <div class="wrap">
      <h2 id="rev-title">{{ b.reviews_title or "What clients say" }}</h2>
      <ul class="quotes">
        {% for r in b.reviews %}<li><blockquote><p>&ldquo;{{ r.quote }}&rdquo;</p></blockquote><cite>{{ r.name }}</cite></li>{% endfor %}
      </ul>
      <p class="src">Quoted word for word from {{ b.reviews_source }}.</p>
    </div>
  </section>
  {% endif %}

{% endmacro %}
{% macro sec_visit() %}
  {% if b.hours or b.address or b.service_area %}
  <section id="visit" aria-labelledby="visit-title">
    <div class="wrap visit-grid{% if not (b.hours and b.address) %} one{% endif %}">
      {% if b.hours or b.service_area %}
      <div>
        <h2 id="visit-title">{% if b.hours %}Hours{% else %}Where I work{% endif %}</h2>
        {% if b.hours_note %}<p class="intro">{{ b.hours_note }}</p>{% endif %}
        {% if b.hours %}<dl class="hours">{% for h in b.hours %}<div><dt>{{ h.days }}</dt><dd>{{ h.time }}</dd></div>{% endfor %}</dl>{% endif %}
        {% if b.service_area %}<p class="area">{{ b.service_area | join(", ") }}</p>{% endif %}
      </div>
      {% endif %}
      {% if b.address %}
      <div>
        {% if b.hours or b.service_area %}<h2>Find me</h2>{% else %}<h2 id="visit-title">Find me</h2>{% endif %}
        <address>{{ b.address }}</address>
        <dl class="contact-list">
          {% if b.phone %}<div><dt>Phone</dt><dd><a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a></dd></div>{% endif %}
          {% if b.email %}<div><dt>Email</dt><dd><a href="mailto:{{ b.email }}">{{ b.email }}</a></dd></div>{% endif %}
        </dl>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

{% endmacro %}
{% macro sec_contact() %}
  <section id="contact" class="req on-dark" aria-labelledby="req-title">
    <div class="wrap req-grid">
      <div>
        <h2 id="req-title">{{ b.contact_title or "Let's talk" }}</h2>
        <p class="intro">{{ b.contact_text or "Book a time, or send a message about coaching or speaking." }}</p>
        {% if b.booking_url %}<div class="actions">{{ out(b.booking_url, b.booking_label or "Book a call", "lav") }}</div>{% endif %}
        {% if b.email %}<a class="mail" href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}
        {% if b.phone %}<a class="tel" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>{% endif %}
      </div>
      {% if mode in ("preview", "sample") or b.form != false %}<div class="form-wrap">{{ m.form(b, mode, "note", "Message", service_label="What is this about?", message_label="Tell me a little about what you need") }}</div>{% endif %}
    </div>
  </section>
{% endmacro %}
{% macro sec_text(s) %}
  <section class="prose-sec" aria-labelledby="t-{{ s.id }}">
    <div class="wrap"><div class="prose{% if s.image %} with-img{% endif %}">
      <div>
        {% if s.label %}<p class="eyebrow">{{ s.label }}</p>{% endif %}
        <h2 id="t-{{ s.id }}">{{ s.heading }}</h2>
        {% for para in s.paragraphs or [] %}<p>{{ para }}</p>{% endfor %}
        {% if s.get("items") %}<ul class="offers">{% for it in s.get("items") %}<li><h3>{{ it.name }}</h3>{% if it.text %}<p>{{ it.text }}</p>{% endif %}</li>{% endfor %}</ul>{% endif %}
      </div>
      {% if s.image %}<div>{{ m.img(s.image, s.image_alt or ("Photo of " ~ b.business_name), "(max-width:1000px) 90vw, 45vw", root=root, cls="prose-img") }}</div>{% endif %}
    </div></div>
  </section>
{% endmacro %}
{% macro sec_gallery(s) %}
  <section class="gallery-sec" aria-labelledby="g-{{ s.id }}">
    <div class="wrap">
      <h2 id="g-{{ s.id }}">{{ s.heading or "Photos" }}</h2>
      {% if s.intro %}<p class="intro">{{ s.intro }}</p>{% endif %}
      <ul class="gallery">{% for g in s.images %}<li>{{ m.img(g, g.alt or ("Photo of " ~ b.business_name), "(max-width:760px) 90vw, 33vw", root=root) }}</li>{% endfor %}</ul>
    </div>
  </section>
{% endmacro %}
<header>
  <div class="wrap bar">
    <a class="brand" href="{{ home_href or '#main' }}">
      {% if b.logo_url %}
      <img class="logo" src="{{ root }}{{ b.logo_url.src }}" width="{{ b.logo_url.width }}" height="{{ b.logo_url.height }}" alt="{{ b.business_name }}{% if page %}, home{% endif %}">
      {% else %}
      <span class="mono" aria-hidden="true">{{ b.initials }}</span>
      <span class="name">{{ b.wm_main }}{% if b.wm_sub %}<i>{{ b.wm_sub }}</i>{% endif %}</span>
      {% endif %}
    </a>
    <nav class="main" aria-label="Main"><ul>{% for n in nav %}<li><a href="{{ n.href }}"{% if n.current %} aria-current="page"{% endif %}>{{ n.label }}</a></li>{% endfor %}</ul></nav>
    <div class="top-cta">{{ book_btn("dark") }}</div>
  </div>
</header>
<main id="main">
  {% if page %}
  <section class="hero page-hero" aria-labelledby="hero-title">
    <div class="wrap">
      {% if page.label %}<p class="eyebrow">{{ page.label }}</p>{% endif %}
      <h1 id="hero-title">{{ page.heading or page.title }}</h1>
      {% if page.intro %}<p class="lede">{{ page.intro }}</p>{% endif %}
    </div>
  </section>
  {% for s in page.sections %}
  {% if s.type == "services" %}{{ sec_services() }}{% elif s.type == "talks" %}{{ sec_talks() }}{% elif s.type == "book" %}{{ sec_book() }}{% elif s.type == "about" %}{{ sec_about() }}{% elif s.type == "reviews" %}{{ sec_reviews() }}{% elif s.type == "visit" %}{{ sec_visit() }}{% elif s.type == "contact" %}{{ sec_contact() }}{% elif s.type == "gallery" %}{{ sec_gallery(s) }}{% else %}{{ sec_text(s) }}{% endif %}
  {% endfor %}
  {% else %}
  {% if b.hero_image_url %}
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        {% if b.kicker or b.role %}<p class="eyebrow">{{ b.kicker or b.role }}</p>{% endif %}
        <h1 id="hero-title" class="{{ b.title_size }}">{{ b.hero_title }}</h1>
        <p class="lede">{{ b.hero_sub }}</p>
        <div class="actions">
          {{ book_btn("dark") }}
          {% if b.talks %}<a class="btn line" href="#talks">{{ b.talks_cta or "See talks" }}</a>{% elif b.book %}<a class="btn line" href="#book">About the book</a>{% endif %}
        </div>
      </div>
      <figure class="portrait">{{ m.img(b.hero_image_url, b.hero_image_alt or ("Photo of " ~ b.business_name), "(max-width:1000px) 90vw, 40vw", eager=True, root=root) }}</figure>
    </div>
  </section>
  {% else %}
  <section class="hero type on-dark" aria-labelledby="hero-title">
    <span class="big-mono" aria-hidden="true">{{ b.initials }}</span>
    <div class="wrap hero-grid">
      <div>
        {% if b.kicker or b.role %}<p class="eyebrow">{{ b.kicker or b.role }}</p>{% endif %}
        <h1 id="hero-title" class="{{ b.title_size }}">{{ b.hero_title }}</h1>
        <p class="lede">{{ b.hero_sub }}</p>
        <div class="actions">{{ book_btn("lav") }}</div>
      </div>
      {% if b.credentials or b.facts %}
      <div class="cred-panel">
        <h2>{{ "Credentials" if b.credentials else "At a glance" }}</h2>
        <ul>{% for c in (b.credentials or b.facts) %}<li>{{ c }}</li>{% endfor %}</ul>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if (b.credentials or b.facts) and b.hero_image_url %}
  <div class="creds on-dark">
    <section style="padding:clamp(32px,4vw,52px) 0" aria-label="{{ 'Credentials' if b.credentials else 'At a glance' }}">
      <div class="wrap"><ul>{% for c in (b.credentials or b.facts) %}<li>{{ c }}</li>{% endfor %}</ul></div>
    </section>
  </div>
  {% endif %}

  {{ sec_services() }}
  {{ sec_talks() }}
  {{ sec_book() }}
  {{ sec_about() }}
  {{ sec_reviews() }}
  {{ sec_visit() }}
  {{ sec_contact() }}
  {% endif %}
</main>
<footer>
  <div class="wrap foot">
    <p>{{ b.business_name }}{% if b.role %}<br>{{ b.role }}{% endif %}</p>
    <p>{% if b.email %}<a href="mailto:{{ b.email }}">{{ b.email }}</a><br>{% endif %}{% if b.phone %}<a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>{% endif %}</p>
    <p>{{ m.footer_credit(b, mode) }}</p>
  </div>
</footer>
<div class="callbar">
  {{ book_btn("dark") }}
  {% if b.email %}<a class="btn line" href="mailto:{{ b.email }}">Email</a>{% elif b.phone %}<a class="btn line" href="tel:{{ b.phone_digits }}">Call</a>{% else %}<a class="btn line" href="{{ contact_href }}">Message</a>{% endif %}
</div>
{% endblock %}
