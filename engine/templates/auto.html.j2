{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{# Auto repair theme. Direct, shop-floor, high contrast. Matches /work/harbor-street-auto/ #}
{% block fontpreload %}<link rel="preload" href="fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin>{% endblock %}
{% block css %}
@font-face{font-family:"Barlow Condensed";src:url(fonts/barlow-condensed-700.woff2) format("woff2");font-weight:700;font-display:swap}
@font-face{font-family:"Barlow Condensed";src:url(fonts/barlow-condensed-600.woff2) format("woff2");font-weight:600;font-display:swap}
@font-face{font-family:"Barlow";src:url(fonts/barlow-400.woff2) format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"Barlow";src:url(fonts/barlow-600.woff2) format("woff2");font-weight:600;font-display:swap}
:root{--asphalt:{{ p.main }};--steel:{{ p.main2 }};--concrete:{{ p.tint }};--paper:{{ p.bg }};--yellow:{{ p.accent }};--ink:{{ p.ink }};--muted:{{ p.ink2 }};--dmuted:{{ p.on_main_muted or "#B4B9C0" }};--line:{{ p.line }};--deep:{{ p.deep }}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;font-family:"Barlow",system-ui,sans-serif;font-size:1.0625rem;line-height:1.6;color:var(--ink);background:var(--paper)}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}
.light :focus-visible{outline-color:#0A58CA}
.wrap{max-width:1280px;margin:0 auto;padding:0 clamp(20px,4.5vw,56px)}
h1,h2,h3{font-family:"Barlow Condensed","Arial Narrow",sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:.005em}
header.top{background:var(--asphalt);color:#fff;border-bottom:1px solid rgba(255,255,255,.12)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:76px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;min-width:0}
.brand .tag{flex:none;display:grid;place-items:center;width:46px;height:46px;background:var(--yellow);color:var(--ink);font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.5rem;letter-spacing:-.02em}
.brand .wm{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.375rem;line-height:1.05;text-transform:uppercase;letter-spacing:.03em}
.brand .wm small{display:block;font-weight:600;font-size:.8125rem;letter-spacing:.2em;color:var(--dmuted);margin-top:4px}
.brand .plate{display:block;background:#fff;padding:6px 10px;border-radius:3px}
.brand .logo{height:44px;width:auto;max-width:220px;object-fit:contain;display:block}
nav.main ul{display:flex;gap:30px;list-style:none;margin:0;padding:0}
nav.main a{text-decoration:none;font-family:"Barlow Condensed",sans-serif;font-weight:600;font-size:1.0625rem;text-transform:uppercase;letter-spacing:.06em;color:#E6E8EB}
nav.main a:hover{color:var(--yellow)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.25rem;text-transform:uppercase;letter-spacing:.04em;padding:14px 24px;line-height:1.1;white-space:nowrap}
.btn.y{background:var(--yellow);color:var(--ink)}
.btn.y:hover{filter:brightness(1.08)}
.btn.o{border:2px solid #fff;color:#fff}
.btn.o:hover{background:#fff;color:var(--ink)}
.hero{position:relative;background:var(--asphalt);color:#fff;overflow:hidden}
.hero > img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ b.hero_image_position or "70% 40%" }}}
.hero.photo:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(18,20,23,.96) 0%,rgba(18,20,23,.88) 38%,rgba(18,20,23,.35) 70%,rgba(18,20,23,.15) 100%)}
.hero .inner{position:relative;z-index:1;padding-top:clamp(64px,9vw,136px);padding-bottom:clamp(64px,9vw,136px)}
.hero.type .inner{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,4fr);gap:clamp(32px,6vw,88px);align-items:end}
.hero.type:before{content:"";position:absolute;left:0;right:0;bottom:0;height:14px;background:repeating-linear-gradient(-45deg,var(--yellow) 0 18px,var(--asphalt) 18px 36px)}
.hero .big-init{position:absolute;right:-.06em;top:-.18em;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:clamp(14rem,34vw,30rem);line-height:1;color:transparent;-webkit-text-stroke:2px rgba(255,255,255,.07);pointer-events:none;user-select:none}
.loc{display:inline-block;font-family:"Barlow Condensed",sans-serif;font-weight:600;font-size:1rem;letter-spacing:.16em;text-transform:uppercase;color:var(--yellow);margin:0 0 18px}
h1{font-size:clamp(3rem,7.6vw,6.5rem);line-height:.9;margin:0 0 26px;max-width:12ch}
h1.mid{font-size:clamp(2.6rem,6vw,5.2rem);max-width:15ch}
h1.long{font-size:clamp(2.3rem,4.8vw,4.2rem);line-height:.95;max-width:19ch}
.hero p.lede{font-size:1.25rem;max-width:38ch;color:#DADDE1;margin:0 0 34px}
.actions{display:flex;flex-wrap:wrap;gap:12px}
.ticket{background:var(--steel);border-top:4px solid var(--yellow);padding:clamp(22px,2.6vw,32px)}
.ticket .k{font-family:"Barlow Condensed",sans-serif;font-weight:600;font-size:.9375rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dmuted);margin:0}
.ticket .tel{display:block;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:clamp(2.2rem,3.6vw,3rem);line-height:1.05;color:var(--yellow);text-decoration:none;font-variant-numeric:tabular-nums;margin:4px 0 18px;overflow-wrap:anywhere}
.ticket table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
.ticket th,.ticket td{font-family:"Barlow Condensed",sans-serif;text-transform:uppercase;font-size:1.25rem;padding:10px 0;border-top:1px dashed rgba(255,255,255,.25);text-align:left;vertical-align:top}
.ticket th{font-weight:600;color:var(--dmuted);padding-right:12px}
.ticket td{font-weight:700;text-align:right}
.strip{background:var(--yellow);color:var(--ink)}
.strip ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat({{ b.facts|length or 1 }},minmax(0,1fr))}
.strip li{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.375rem;text-transform:uppercase;line-height:1.1;padding:22px 20px 22px 0}
.strip li+li{padding-left:20px;border-left:2px solid rgba(18,20,23,.2)}
section{padding:clamp(72px,9vw,120px) 0}
h2{font-size:clamp(2.4rem,5vw,4.25rem);line-height:.95;margin:0}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;margin-bottom:48px;flex-wrap:wrap}
.head p{margin:0;max-width:44ch;color:var(--muted)}
.dark{background:var(--steel);color:#fff}
.dark .head p{color:var(--dmuted)}
.board{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat({{ b.svc_cols }},minmax(0,1fr));border-top:1px solid rgba(255,255,255,.16);border-left:1px solid rgba(255,255,255,.16)}
.board li{border-right:1px solid rgba(255,255,255,.16);border-bottom:1px solid rgba(255,255,255,.16);padding:30px 30px 34px;min-height:220px;display:flex;flex-direction:column}
.board .no{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1rem;color:var(--yellow);letter-spacing:.1em}
.board h3{font-size:1.875rem;line-height:1;margin:auto 0 10px;padding-top:36px}
.board p{margin:0;color:var(--dmuted)}
.about-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,88px);align-items:start}
.about-grid.solo{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}
.about-grid img{width:100%;aspect-ratio:4/3;object-fit:cover}
.about-grid h2{margin-bottom:28px}
.about-grid p{margin:0 0 18px;max-width:54ch}
.about-grid .first{font-size:1.25rem}
.checks{list-style:none;margin:28px 0 0;padding:0}
.checks li{display:grid;grid-template-columns:56px 1fr;gap:16px;padding:16px 0;border-top:2px solid var(--ink);font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.5rem;text-transform:uppercase;line-height:1.1;align-items:baseline}
.checks li span{font-size:1rem;letter-spacing:.1em;color:var(--muted)}
.reviews{background:var(--concrete)}
.quotes{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat({{ [b.reviews|length, 3]|min }},minmax(0,1fr));gap:clamp(16px,2.5vw,28px)}
.quotes li{background:#fff;border-left:6px solid var(--yellow);padding:28px}
.quotes blockquote{margin:0;font-size:1.125rem}
.quotes blockquote p{margin:0}
.quotes cite{display:block;font-style:normal;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.25rem;text-transform:uppercase;letter-spacing:.04em;margin-top:16px}
.src{font-size:.9375rem;color:var(--muted);margin:28px 0 0}
.visit{background:var(--concrete)}
.visit-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(24px,4vw,48px)}
.visit-grid.one{grid-template-columns:minmax(0,1fr);max-width:760px}
.sign{background:var(--asphalt);color:#fff;padding:clamp(28px,4vw,48px)}
.sign .open{display:inline-block;background:var(--yellow);color:var(--ink);font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.125rem;letter-spacing:.18em;text-transform:uppercase;padding:6px 12px;margin-bottom:24px}
.sign table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
.sign th,.sign td{font-family:"Barlow Condensed",sans-serif;text-transform:uppercase;font-size:1.625rem;padding:14px 0;border-bottom:1px dashed #4A515A;text-align:left;vertical-align:top}
.sign th{font-weight:600;color:var(--dmuted);padding-right:16px}
.sign td{font-weight:700;text-align:right}
.place{background:#fff;border:1px solid var(--line);padding:clamp(28px,4vw,48px);display:flex;flex-direction:column;gap:24px}
.place address{font-style:normal;font-size:1.25rem;line-height:1.45}
.place address b{font-family:"Barlow Condensed",sans-serif;font-size:2.25rem;text-transform:uppercase;display:block;line-height:1;margin-bottom:10px}
.place .area{margin:0;color:var(--muted)}
.place .area b{display:block;font-family:"Barlow Condensed",sans-serif;font-size:1.125rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink)}
.place .row{display:flex;gap:12px;flex-wrap:wrap;margin-top:auto}
.btn.k{background:var(--ink);color:#fff}
.btn.k:hover{background:#2A2F36}
.btn.ko{border:2px solid var(--ink);color:var(--ink)}
.btn.ko:hover{background:var(--ink);color:#fff}
.contact{background:var(--asphalt);color:#fff}
.contact-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,6vw,88px)}
.contact p.intro{color:var(--dmuted);max-width:38ch;margin:20px 0 0}
.bigtel{display:inline-block;margin-top:24px;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:clamp(2.5rem,5vw,4rem);color:var(--yellow);text-decoration:none;line-height:1;font-variant-numeric:tabular-nums}
.bigtel:hover{text-decoration:underline;text-underline-offset:6px}
.contact .mail{overflow-wrap:anywhere}
form{background:var(--paper);color:var(--ink);padding:clamp(24px,3.5vw,40px)}
form :focus-visible{outline-color:#0A58CA}
.note{background:#FFF3C4;border-left:4px solid var(--yellow);padding:12px 14px;font-size:.9375rem;margin:0 0 22px}
fieldset{border:0;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:16px;min-width:0}
label{display:block;font-weight:600;font-size:.9375rem}
.full{grid-column:1/-1}
input,select,textarea{display:block;width:100%;margin-top:6px;font:inherit;font-size:1rem;padding:12px 14px;border:1.5px solid #8E939A;border-radius:0;background:#ECEDEB;color:var(--ink)}
textarea{min-height:110px}
button[disabled]{margin-top:20px;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.25rem;text-transform:uppercase;letter-spacing:.04em;background:#5C6168;color:#fff;border:0;padding:14px 24px;cursor:not-allowed}
footer{background:var(--deep);color:#B4B9C0;padding:44px 0 56px;font-size:.9375rem}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px}
.foot p{margin:0}
footer a{color:#fff}
.callbar{display:none}
@media (max-width:1000px){
  nav.main{display:none}
  .strip ul{grid-template-columns:1fr 1fr}
  .strip li:nth-child(odd){padding-left:0;border-left:0}
  .strip li:nth-child(n+3){border-top:2px solid rgba(18,20,23,.2)}
  .board{grid-template-columns:1fr 1fr}
  .hero.type .inner,.about-grid,.about-grid.solo,.visit-grid,.contact-grid{grid-template-columns:1fr}
  .quotes{grid-template-columns:1fr}
}
@media (max-width:760px){
  .bar{min-height:64px}
  .bar > .btn{display:none}
  .brand .logo{height:38px;max-width:190px}
  .hero.photo:after{background:linear-gradient(180deg,rgba(18,20,23,.75) 0%,rgba(18,20,23,.92) 60%,rgba(18,20,23,.97) 100%)}
  .strip ul{grid-template-columns:1fr}
  .strip li,.strip li+li,.strip li:nth-child(odd){padding:14px 0;border-left:0;font-size:1.25rem}
  .strip li+li{border-top:2px solid rgba(18,20,23,.2)}
  .board{grid-template-columns:1fr}
  .board li{min-height:0;padding:24px}
  .board h3{padding-top:14px}
  fieldset{grid-template-columns:1fr}
  .sign th,.sign td{font-size:1.25rem}
  .callbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:20;gap:8px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:var(--asphalt);border-top:1px solid rgba(255,255,255,.14)}
  .callbar .btn{flex:1;padding:14px 10px;font-size:1.125rem}
  .callbar .btn.o{flex:.8}
  footer{padding-bottom:110px}
}
{% endblock %}
{% block body %}
<header class="top">
  <div class="wrap bar">
    <a class="brand" href="#main">
      {% if b.logo_url %}
      <span class="plate"><img class="logo" src="{{ b.logo_url.src }}" width="{{ b.logo_url.width }}" height="{{ b.logo_url.height }}" alt="{{ b.business_name }}"></span>
      {% else %}
      <span class="tag" aria-hidden="true">{{ b.initials }}</span><span class="wm">{{ b.wm_main }}{% if b.wm_sub or b.city %}<small>{{ b.wm_sub or b.city }}</small>{% endif %}</span>
      {% endif %}
    </a>
    <nav class="main" aria-label="Main"><ul><li><a href="#services">Services</a></li><li><a href="#about">About</a></li>{% if b.hours or b.address %}<li><a href="#visit">{% if b.hours and b.address %}Hours and location{% elif b.hours %}Hours{% else %}Location{% endif %}</a></li>{% endif %}<li><a href="#contact">Contact</a></li></ul></nav>
    {% if b.phone %}<a class="btn y" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>{% else %}<a class="btn y" href="#contact">Contact</a>{% endif %}
  </div>
</header>
<main id="main">
  {% if b.hero_image_url %}
  <div class="hero photo">
    {{ m.img(b.hero_image_url, b.hero_image_alt or ("Photo from " ~ b.business_name), "100vw", eager=True) }}
    <div class="wrap inner">
      {% if b.kicker or b.city %}<p class="loc">{{ b.kicker or b.city }}</p>{% endif %}
      <h1 class="{{ b.title_size }}">{{ b.hero_title }}</h1>
      <p class="lede">{{ b.hero_sub }}</p>
      <div class="actions">
        {% if b.phone %}<a class="btn y" href="tel:{{ b.phone_digits }}">Call {{ b.phone }}</a>{% endif %}
        <a class="btn {{ 'o' if b.phone else 'y' }}" href="#contact">{{ b.cta_label or "Send a request" }}</a>
      </div>
    </div>
  </div>
  {% else %}
  <div class="hero type">
    <span class="big-init" aria-hidden="true">{{ b.initials }}</span>
    <div class="wrap inner">
      <div>
        {% if b.kicker or b.city %}<p class="loc">{{ b.kicker or b.city }}</p>{% endif %}
        <h1 class="{{ b.title_size }}">{{ b.hero_title }}</h1>
        <p class="lede">{{ b.hero_sub }}</p>
        <div class="actions">
          {% if b.phone %}<a class="btn y" href="tel:{{ b.phone_digits }}">Call {{ b.phone }}</a>{% endif %}
          <a class="btn {{ 'o' if b.phone else 'y' }}" href="#contact">{{ b.cta_label or "Send a request" }}</a>
        </div>
      </div>
      <div class="ticket">
        {% if b.phone %}<p class="k">Call the shop</p><a class="tel" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>
        {% else %}<p class="k">Email the shop</p><a class="tel" style="font-size:1.5rem" href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}
        {% if b.hours %}<table><caption class="sr">Hours</caption><tbody>{% for h in b.hours[:4] %}<tr><th scope="row">{{ h.days }}</th><td>{{ h.time }}</td></tr>{% endfor %}</tbody></table>{% endif %}
      </div>
    </div>
  </div>
  {% endif %}
  {% if b.facts %}
  <div class="strip"><div class="wrap"><ul>{% for f in b.facts %}<li>{{ f }}</li>{% endfor %}</ul></div></div>
  {% endif %}

  <section id="services" class="dark" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="head">
        <h2 id="svc-title">{{ b.services_title or "What we work on" }}</h2>
        {% if b.services_intro %}<p>{{ b.services_intro }}</p>{% endif %}
      </div>
      <ul class="board">
        {% for s in b.services %}<li><span class="no">{{ "%02d" % loop.index }}</span><h3>{{ s.name }}</h3>{% if s.text %}<p>{{ s.text }}</p>{% endif %}</li>{% endfor %}
      </ul>
    </div>
  </section>

  <section id="about" class="light" aria-labelledby="about-title">
    <div class="wrap about-grid{% if not b.about_image_url %} solo{% endif %}">
      <div>
        <h2 id="about-title">{{ b.about_title or ("About " ~ b.business_name) }}</h2>
        {% if b.about_image_url %}{% for para in b.about %}<p{% if loop.first %} class="first"{% endif %}>{{ para }}</p>{% endfor %}
        {% elif b.facts %}<ul class="checks">{% for f in b.facts %}<li><span>{{ "%02d" % loop.index }}</span>{{ f }}</li>{% endfor %}</ul>{% endif %}
      </div>
      {% if b.about_image_url %}<figure style="margin:0">{{ m.img(b.about_image_url, b.about_image_alt or ("Photo from " ~ b.business_name), "(max-width:1000px) 90vw, 45vw") }}</figure>
      {% else %}<div>{% for para in b.about %}<p{% if loop.first %} class="first"{% endif %}>{{ para }}</p>{% endfor %}</div>{% endif %}
    </div>
  </section>

  {% if b.reviews %}
  <section class="reviews light" aria-labelledby="rev-title">
    <div class="wrap">
      <div class="head"><h2 id="rev-title">{{ b.reviews_title or "What customers say" }}</h2></div>
      <ul class="quotes">
        {% for r in b.reviews %}<li><blockquote><p>&ldquo;{{ r.quote }}&rdquo;</p></blockquote><cite>{{ r.name }}</cite></li>{% endfor %}
      </ul>
      <p class="src">Quoted word for word from {{ b.reviews_source }}.</p>
    </div>
  </section>
  {% endif %}

  {% if b.hours or b.address or b.service_area %}
  <section id="visit" class="visit light" aria-labelledby="visit-title">
    <div class="wrap">
      <div class="head"><h2 id="visit-title">{% if b.hours and b.address %}Hours and location{% elif b.hours %}Hours{% elif b.address %}Location{% else %}Where we work{% endif %}</h2>{% if b.hours_note %}<p>{{ b.hours_note }}</p>{% endif %}</div>
      <div class="visit-grid{% if not (b.hours and (b.address or b.service_area)) %} one{% endif %}">
        {% if b.hours %}
        <div class="sign">
          <span class="open">Open</span>
          <table><caption class="sr">Opening hours</caption><tbody>{% for h in b.hours %}<tr><th scope="row">{{ h.days }}</th><td>{{ h.time }}</td></tr>{% endfor %}</tbody></table>
        </div>
        {% endif %}
        {% if b.address or b.service_area %}
        <div class="place">
          {% if b.address %}<address><b>{{ b.business_name }}</b>{{ b.address }}</address>{% endif %}
          {% if b.service_area %}<p class="area"><b>Serving</b>{{ b.service_area | join(", ") }}</p>{% endif %}
          <div class="row">
            {% if b.map_url %}<a class="btn k" href="{{ b.map_url }}" rel="noopener">Get directions</a>{% endif %}
            {% if b.phone %}<a class="btn ko" href="tel:{{ b.phone_digits }}">Call ahead</a>{% endif %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  <section id="contact" class="contact" aria-labelledby="est-title">
    <div class="wrap contact-grid">
      <div>
        <h2 id="est-title">{{ b.contact_title or "Get in touch" }}</h2>
        <p class="intro">{{ b.contact_text or ("Call the shop or send a request." if b.phone else "Send an email or a request.") }}</p>
        {% if b.phone %}<a class="bigtel" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>{% endif %}
        {% if b.email %}<p class="mail"><a href="mailto:{{ b.email }}">{{ b.email }}</a></p>{% endif %}
      </div>
      <form aria-labelledby="form-title" onsubmit="return false">
        <h3 id="form-title" class="sr">Service request</h3>
        <p class="note">{{ m.form_note(b) }}</p>
        <fieldset disabled>
          <label>Name<input name="name" autocomplete="name"></label>
          <label>Phone<input name="phone" type="tel" autocomplete="tel"></label>
          <label class="full">Year, make and model<input name="vehicle"></label>
          <label class="full">What is the car doing?<textarea name="message"></textarea></label>
        </fieldset>
        <button type="submit" disabled>Send request</button>
      </form>
    </div>
  </section>
</main>
<footer>
  <div class="wrap foot">
    <p>{{ b.business_name }}{% if b.address %}<br>{{ b.address }}{% endif %}</p>
    <p>{% if b.phone %}<a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a><br>{% endif %}{% if b.email %}<a href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}</p>
    <p>A concept by <a href="https://tangerinesstudio.com/">Tangerines Studio</a>.<br>{% if b.domain %}Content from {{ b.domain }}.{% else %}Not the official website.{% endif %}</p>
  </div>
</footer>
<div class="callbar">
  {% if b.phone %}<a class="btn y" href="tel:{{ b.phone_digits }}">Call the shop</a>{% endif %}
  <a class="btn {{ 'o' if b.phone else 'y' }}" href="#contact">Request</a>
</div>
{% endblock %}
