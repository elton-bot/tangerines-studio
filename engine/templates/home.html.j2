{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{# Home services theme. Sturdy, local, family. Matches /work/juniper-ridge-heating-air/ #}
{% block fontpreload %}<link rel="preload" href="fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>{% endblock %}
{% block css %}
@font-face{font-family:"Archivo";src:url(fonts/archivo.woff2) format("woff2");font-weight:100 900;font-stretch:62% 125%;font-display:swap}
:root{--main:{{ p.main }};--main2:{{ p.main2 }};--tint:{{ p.tint }};--accent:{{ p.accent }};--bg:{{ p.bg }};--ink:{{ p.ink }};--ink2:{{ p.ink2 }};--line:{{ p.line }};--deep:{{ p.deep }}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;font-family:"Archivo",system-ui,sans-serif;font-size:1.0625rem;line-height:1.6;color:var(--ink);background:var(--bg)}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
:focus-visible{outline:3px solid #0B6E99;outline-offset:3px;border-radius:2px}
.on-dark :focus-visible{outline-color:#fff}
.wrap{max-width:1240px;margin:0 auto;padding:0 clamp(20px,4.5vw,56px)}
header.top{border-bottom:1px solid var(--line);background:var(--bg)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:80px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;min-width:0}
.brand .mono{flex:none;display:grid;place-items:center;width:44px;height:44px;border-radius:8px;background:var(--main);color:#fff;font-stretch:80%;font-weight:800;font-size:1.125rem;letter-spacing:.02em;position:relative;overflow:hidden}
.brand .mono:after{content:"";position:absolute;left:0;right:0;bottom:0;height:7px;background:var(--accent)}
.brand b{display:block;font-stretch:88%;font-weight:800;font-size:1.25rem;letter-spacing:-.01em;line-height:1.05}
.brand small{display:block;font-size:.75rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ink2);margin-top:4px}
.brand .logo{height:52px;width:auto;max-width:240px;object-fit:contain}
nav.main ul{display:flex;gap:28px;list-style:none;margin:0;padding:0}
nav.main a{text-decoration:none;font-weight:500;font-size:.95rem}
nav.main a:hover{text-decoration:underline;text-underline-offset:4px}
.phone-btn{display:inline-flex;align-items:center;gap:10px;background:var(--main);color:#fff;text-decoration:none;font-weight:700;padding:12px 18px;border-radius:6px;white-space:nowrap;font-variant-numeric:tabular-nums}
.phone-btn:hover{background:var(--main2)}
.hero{background:var(--main);color:#fff}
.hero.photo-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr)}
.hero .copy{padding:clamp(48px,7vw,112px) clamp(20px,4.5vw,56px) clamp(48px,6vw,96px) max(clamp(20px,4.5vw,56px),calc((100vw - 1240px)/2 + 56px))}
.kicker{font-weight:600;font-size:.875rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 20px}
h1{font-stretch:82%;font-weight:800;font-size:clamp(2.5rem,5.4vw,4.6rem);line-height:.98;letter-spacing:-.02em;margin:0 0 24px;max-width:14ch}
h1.mid{font-size:clamp(2.25rem,4.6vw,3.9rem);max-width:17ch}
h1.long{font-size:clamp(2rem,3.8vw,3.2rem);line-height:1.04;max-width:22ch}
.hero p.lede{font-size:1.1875rem;max-width:38ch;color:#E3ECE7;margin:0 0 36px}
.actions{display:flex;flex-wrap:wrap;gap:14px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:700;text-decoration:none;padding:16px 24px;border-radius:6px;font-size:1.0625rem}
.btn.light{background:var(--tint);color:var(--main)}
.btn.light:hover{background:#fff}
.btn.ghost{border:1.5px solid rgba(255,255,255,.6);color:#fff}
.btn.ghost:hover{border-color:#fff}
.hero .photo{position:relative;min-height:440px}
.hero .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ b.hero_image_position or "60% 50%" }}}
.type-hero{position:relative;overflow:hidden}
.type-hero .roofs{position:absolute;right:0;bottom:0;width:min(62vw,860px);height:auto;pointer-events:none}
.type-hero .wrap{position:relative;display:grid;grid-template-columns:minmax(0,7fr) minmax(0,4fr);gap:clamp(32px,6vw,96px);align-items:end;padding-top:clamp(56px,8vw,128px);padding-bottom:clamp(56px,7vw,112px)}
.type-hero h1{max-width:15ch;font-size:clamp(2.75rem,6.4vw,5.6rem)}
.type-hero h1.mid{font-size:clamp(2.4rem,5.2vw,4.5rem);max-width:18ch}
.type-hero h1.long{font-size:clamp(2.1rem,4.2vw,3.5rem);max-width:22ch}
.panel{border-top:2px solid var(--accent);padding-top:22px}
.panel .label{font-size:.8125rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 6px}
.panel .tel{display:block;font-stretch:80%;font-weight:800;font-size:clamp(2rem,3.4vw,2.9rem);line-height:1.05;text-decoration:none;font-variant-numeric:tabular-nums;margin-bottom:22px;overflow-wrap:anywhere}
.panel .tel:hover{text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:2px}
.panel dl{margin:0;border-top:1px solid rgba(255,255,255,.2)}
.panel dl div{display:flex;justify-content:space-between;gap:16px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.2);font-size:.98rem}
.panel dt{color:#D2DED8}.panel dd{margin:0;font-weight:600;text-align:right}
.promise{background:var(--main2);color:#fff}
.promise ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat({{ b.facts|length or 1 }},minmax(0,1fr))}
.promise li{padding:26px 28px 26px 0;display:flex;gap:14px;align-items:flex-start;font-weight:600;line-height:1.35}
.promise li+li{padding-left:28px;border-left:1px solid rgba(255,255,255,.2)}
.promise svg{flex:none;margin-top:1px}
section{padding:clamp(72px,9vw,128px) 0}
.sec-head{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:40px;align-items:end;margin-bottom:56px}
h2{font-stretch:84%;font-weight:800;font-size:clamp(2rem,3.8vw,3.25rem);line-height:1.02;letter-spacing:-.015em;margin:0}
.sec-head p{margin:0;color:var(--ink2);max-width:52ch}
.svc{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat({{ b.svc_cols }},minmax(0,1fr));border-top:2px solid var(--ink)}
.svc li{padding:26px 32px 30px 0;border-bottom:1px solid var(--line)}
.svc li:not(:nth-child({{ b.svc_cols }}n+1)){padding-left:32px;border-left:1px solid var(--line)}
.svc .no{display:block;font-size:.8125rem;font-weight:700;letter-spacing:.14em;color:var(--ink2);margin-bottom:14px;font-variant-numeric:tabular-nums}
.svc h3{font-stretch:90%;font-weight:700;font-size:1.375rem;line-height:1.2;margin:0 0 8px}
.svc p{margin:0;color:var(--ink2)}
.reviews{background:var(--bg);border-top:1px solid var(--line)}
.quotes{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat({{ [b.reviews|length, 3]|min }},minmax(0,1fr));gap:clamp(24px,4vw,56px)}
.quotes li{border-top:2px solid var(--main);padding-top:24px}
.quotes blockquote{margin:0;font-size:1.125rem;line-height:1.55}
.quotes blockquote p{margin:0 0 12px}
.quotes .mark{display:block;font-stretch:80%;font-weight:800;font-size:3rem;line-height:.6;color:var(--main);margin-bottom:12px}
.quotes cite{display:block;font-style:normal;font-weight:700;margin-top:6px}
.src{font-size:.9375rem;color:var(--ink2);margin:32px 0 0}
.about{background:var(--tint)}
.about-grid{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(32px,6vw,88px);align-items:center}
.about-grid.solo{grid-template-columns:minmax(0,7fr) minmax(0,5fr);align-items:start}
.about-photo img{border-radius:4px;width:100%;aspect-ratio:4/3;object-fit:cover}
.about h2{margin-bottom:24px}
.about p{margin:0 0 18px;max-width:54ch}
.small-label{font-size:.875rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink2);margin:0 0 12px}
.checks{list-style:none;padding:0;margin:28px 0 0;border-top:1px solid rgba(20,32,27,.22)}
.checks li{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid rgba(20,32,27,.22);font-weight:600}
.checks svg{flex:none;margin-top:3px}
.visit{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,96px)}
.visit.one{grid-template-columns:minmax(0,1fr)}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:16px 0;border-bottom:1px solid var(--line);font-size:1.125rem;vertical-align:top}
th{font-weight:600;padding-right:16px}
td{text-align:right;color:var(--ink2)}
.towns{list-style:none;margin:0;padding:0}
.towns li{font-stretch:80%;font-weight:800;font-size:clamp(1.75rem,3.6vw,3rem);line-height:1.1;letter-spacing:-.015em;color:var(--main);border-bottom:1px solid var(--line);padding:8px 0}
.towns.many{display:flex;flex-wrap:wrap;gap:0 24px}
.towns.many li{font-size:clamp(1.25rem,2.2vw,1.75rem);border:0;padding:4px 0}
.addr{font-style:normal;font-size:1.125rem;margin:28px 0 0}
.addr a{font-weight:600}
.contact{background:var(--main);color:#fff}
.contact-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(32px,6vw,96px)}
.contact h2{margin-bottom:20px}
.contact p{color:#E3ECE7;max-width:40ch}
.big-phone{display:inline-block;font-stretch:80%;font-weight:800;font-size:clamp(2.2rem,4.6vw,3.6rem);letter-spacing:-.01em;color:#fff;text-decoration:none;margin:16px 0 8px;font-variant-numeric:tabular-nums}
.big-phone:hover{text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:2px}
.contact .mail{overflow-wrap:anywhere}
form{background:var(--bg);color:var(--ink);padding:clamp(24px,3.5vw,40px);border-radius:6px}
.contact form p{color:var(--ink);max-width:none}
.form-note{background:var(--tint);color:var(--ink);font-size:.9375rem;padding:12px 14px;border-radius:4px;margin:0 0 22px}
fieldset{border:0;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:16px;min-width:0}
label{display:block;font-weight:600;font-size:.9375rem}
label.full{grid-column:1/-1}
input,select,textarea{display:block;width:100%;margin-top:6px;font:inherit;font-size:1rem;padding:12px 14px;border:1.5px solid #8E9C95;border-radius:4px;background:#EEF1EF;color:var(--ink)}
textarea{min-height:110px;resize:vertical}
button[disabled]{margin-top:20px;font:inherit;font-weight:700;background:#55625C;color:#fff;border:0;border-radius:6px;padding:14px 22px;cursor:not-allowed}
footer{background:var(--deep);color:#C9D3CE;padding:48px 0 56px;font-size:.9375rem}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px}
.foot p{margin:0}
footer a{color:#fff}
.callbar{display:none}
@media (max-width:980px){
  nav.main{display:none}
  .hero.photo-hero{grid-template-columns:1fr}
  .hero .copy{padding:48px 20px 44px}
  .hero .photo{min-height:0;aspect-ratio:3/2}
  .type-hero .roofs{width:100%;opacity:.7}
  .type-hero .wrap{grid-template-columns:1fr;gap:40px;padding-top:52px;padding-bottom:52px}
  .promise ul{grid-template-columns:1fr}
  .promise li,.promise li+li{padding:16px 0;border-left:0;border-top:1px solid rgba(255,255,255,.2)}
  .promise li:first-child{border-top:0}
  .sec-head,.about-grid,.about-grid.solo,.visit,.contact-grid{grid-template-columns:1fr}
  .sec-head{gap:16px}
  .svc{grid-template-columns:1fr 1fr}
  .svc li,.svc li:not(:nth-child({{ b.svc_cols }}n+1)){padding:24px 24px 26px 0;border-left:0}
  .svc li:nth-child(2n){padding-left:24px;border-left:1px solid var(--line)}
  .quotes{grid-template-columns:1fr}
}
@media (max-width:760px){
  .bar{min-height:68px}
  .bar .phone-btn{display:none}
  .brand .logo{height:44px;max-width:200px}
  .svc{grid-template-columns:1fr}
  .svc li,.svc li:nth-child(2n){padding:22px 0;border-left:0}
  fieldset{grid-template-columns:1fr}
  .callbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:20;gap:10px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:var(--bg);border-top:1px solid var(--line)}
  .callbar a{flex:1.6;justify-content:center;white-space:nowrap;padding:14px 12px;font-size:1rem}
  .callbar .call{background:var(--main);color:#fff}
  .callbar .req{border:1.5px solid var(--main);color:var(--main);flex:1}
  footer{padding-bottom:110px}
}
{% endblock %}
{% block body %}
{% set tick %}<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" d="M4 12l5 5L20 6"/></svg>{% endset %}
<header class="top">
  <div class="wrap bar">
    <a class="brand" href="#main">
      {% if b.logo_url %}
      <img class="logo" src="{{ b.logo_url.src }}" width="{{ b.logo_url.width }}" height="{{ b.logo_url.height }}" alt="{{ b.business_name }}">
      {% else %}
      <span class="mono" aria-hidden="true">{{ b.initials }}</span>
      <span><b>{{ b.wm_main }}</b>{% if b.wm_sub %}<small>{{ b.wm_sub }}</small>{% endif %}</span>
      {% endif %}
    </a>
    <nav class="main" aria-label="Main"><ul><li><a href="#services">Services</a></li><li><a href="#about">About</a></li>{% if b.hours or b.service_area or b.address %}<li><a href="#hours">{% if b.hours %}Hours{% else %}Visit{% endif %}</a></li>{% endif %}<li><a href="#contact">Contact</a></li></ul></nav>
    {% if b.phone %}<a class="phone-btn" href="tel:{{ b.phone_digits }}">{{ icon_phone | safe }}{{ b.phone }}</a>{% else %}<a class="phone-btn" href="#contact">Contact us</a>{% endif %}
  </div>
</header>
<main id="main">
  {% if b.hero_image_url %}
  <div class="hero photo-hero on-dark">
    <div class="copy">
      {% if b.kicker or b.city %}<p class="kicker">{{ b.kicker or b.city }}</p>{% endif %}
      <h1 class="{{ b.title_size }}">{{ b.hero_title }}</h1>
      <p class="lede">{{ b.hero_sub }}</p>
      <div class="actions">
        {% if b.phone %}<a class="btn light" href="tel:{{ b.phone_digits }}">Call {{ b.phone }}</a>{% endif %}
        <a class="btn {{ 'ghost' if b.phone else 'light' }}" href="#contact">{{ b.cta_label or "Request service" }}</a>
      </div>
    </div>
    <div class="photo">{{ m.img(b.hero_image_url, b.hero_image_alt or ("Photo from " ~ b.business_name), "(max-width:980px) 100vw, 50vw", eager=True) }}</div>
  </div>
  {% else %}
  <div class="hero type-hero on-dark">
    <svg class="roofs" viewBox="0 0 860 220" aria-hidden="true" focusable="false"><path d="M0 220V170l70-52 70 52v50M120 220v-82l95-70 95 70v82M290 220v-60l60-44 60 44v60M390 220V120l120-88 120 88v100M610 220v-70l80-58 80 58v70M750 220v-48l55-40 55 40" fill="none" stroke="{{ p.accent }}" stroke-opacity=".16" stroke-width="2"/><path d="M470 220v-46h80v46M182 220v-36h46v36" fill="none" stroke="{{ p.accent }}" stroke-opacity=".16" stroke-width="2"/></svg>
    <div class="wrap">
      <div>
        {% if b.kicker or b.city %}<p class="kicker">{{ b.kicker or b.city }}</p>{% endif %}
        <h1 class="{{ b.title_size }}">{{ b.hero_title }}</h1>
        <p class="lede">{{ b.hero_sub }}</p>
        <div class="actions">
          {% if b.phone %}<a class="btn light" href="tel:{{ b.phone_digits }}">Call {{ b.phone }}</a>{% endif %}
          <a class="btn {{ 'ghost' if b.phone else 'light' }}" href="#contact">{{ b.cta_label or "Request service" }}</a>
        </div>
      </div>
      <div class="panel">
        {% if b.phone %}<p class="label">Call us</p><a class="tel" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>
        {% else %}<p class="label">Email us</p><a class="tel" style="font-size:1.5rem" href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}
        {% if b.hours %}
        <dl>{% for h in b.hours[:4] %}<div><dt>{{ h.days }}</dt><dd>{{ h.time }}</dd></div>{% endfor %}</dl>
        {% elif b.service_area %}
        <dl>{% for t in b.service_area[:5] %}<div><dt>Serving</dt><dd>{{ t }}</dd></div>{% endfor %}</dl>
        {% endif %}
      </div>
    </div>
  </div>
  {% endif %}
  {% if b.facts %}
  <div class="promise">
    <div class="wrap">
      <ul>{% for f in b.facts %}<li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="{{ p.accent }}" stroke-width="2" d="M4 12l5 5L20 6"/></svg>{{ f }}</li>{% endfor %}</ul>
    </div>
  </div>
  {% endif %}

  <section id="services" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="svc-title">{{ b.services_title or "Services" }}</h2>
        {% if b.services_intro %}<p>{{ b.services_intro }}</p>{% endif %}
      </div>
      <ul class="svc">
        {% for s in b.services %}<li><span class="no">{{ "%02d" % loop.index }}</span><h3>{{ s.name }}</h3>{% if s.text %}<p>{{ s.text }}</p>{% endif %}</li>{% endfor %}
      </ul>
    </div>
  </section>

  {% if b.reviews %}
  <section class="reviews" aria-labelledby="rev-title">
    <div class="wrap">
      <div class="sec-head"><h2 id="rev-title">{{ b.reviews_title or "What customers say" }}</h2></div>
      <ul class="quotes">
        {% for r in b.reviews %}<li><span class="mark" aria-hidden="true">&ldquo;</span><blockquote><p>{{ r.quote }}</p></blockquote><cite>{{ r.name }}</cite></li>{% endfor %}
      </ul>
      <p class="src">Quoted word for word from {{ b.reviews_source }}.</p>
    </div>
  </section>
  {% endif %}

  <section id="about" class="about" aria-labelledby="about-title">
    <div class="wrap about-grid{% if not b.about_image_url %} solo{% endif %}">
      {% if b.about_image_url %}<div class="about-photo">{{ m.img(b.about_image_url, b.about_image_alt or ("Photo from " ~ b.business_name), "(max-width:980px) 90vw, 50vw") }}</div>{% endif %}
      <div>
        <p class="small-label">About us</p>
        <h2 id="about-title">{{ b.about_title or ("About " ~ b.business_name) }}</h2>
        {% for para in b.about %}<p>{{ para }}</p>{% endfor %}
        {% if b.about_image_url and b.facts %}<ul class="checks">{% for f in b.facts %}<li>{{ tick | safe }}{{ f }}</li>{% endfor %}</ul>{% endif %}
      </div>
      {% if not b.about_image_url and b.facts %}<ul class="checks">{% for f in b.facts %}<li>{{ tick | safe }}{{ f }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </section>

  {% if b.hours or b.service_area or b.address %}
  <section id="hours" aria-labelledby="hours-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="hours-title">{% if b.hours and b.service_area %}Hours and service area{% elif b.hours %}Hours{% elif b.service_area %}Service area{% else %}Visit us{% endif %}</h2>
        {% if b.hours_note %}<p>{{ b.hours_note }}</p>{% endif %}
      </div>
      <div class="visit{% if not (b.hours and (b.service_area or b.address)) %} one{% endif %}">
        {% if b.hours %}
        <div>
          <p class="small-label">Hours</p>
          <table><caption class="sr">Hours</caption><tbody>{% for h in b.hours %}<tr><th scope="row">{{ h.days }}</th><td>{{ h.time }}</td></tr>{% endfor %}</tbody></table>
        </div>
        {% endif %}
        {% if b.service_area or b.address %}
        <div>
          {% if b.service_area %}
          <p class="small-label">Areas we serve</p>
          <ul class="towns{% if b.service_area|length > 6 %} many{% endif %}">{% for t in b.service_area %}<li>{{ t }}</li>{% endfor %}</ul>
          {% endif %}
          {% if b.address %}<address class="addr">{{ b.address }}{% if b.map_url %}<br><a href="{{ b.map_url }}" rel="noopener">Get directions</a>{% endif %}</address>{% endif %}
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  <section id="contact" class="contact on-dark" aria-labelledby="contact-title">
    <div class="wrap contact-grid">
      <div>
        <h2 id="contact-title">{{ b.contact_title or "Get in touch" }}</h2>
        <p>{{ b.contact_text or ("Call or send a request." if b.phone else "Send an email or a request.") }}</p>
        {% if b.phone %}<a class="big-phone" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>{% endif %}
        {% if b.email %}<p class="mail"><a href="mailto:{{ b.email }}">{{ b.email }}</a></p>{% endif %}
      </div>
      <form aria-labelledby="form-title" onsubmit="return false">
        <h3 id="form-title" class="sr">Service request</h3>
        <p class="form-note">{{ m.form_note(b) }}</p>
        {{ m.form_fields(b) }}
      </form>
    </div>
  </section>
</main>
<footer>
  <div class="wrap foot">
    <p>{{ b.business_name }}{% if b.address %}<br>{{ b.address }}{% elif b.service_area %}<br>Serving {{ b.service_area | join(", ") }}{% endif %}</p>
    <p>{% if b.phone %}<a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a><br>{% endif %}{% if b.email %}<a href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}</p>
    <p>A concept by <a href="https://tangerinesstudio.com/">Tangerines Studio</a>.<br>{% if b.domain %}Content from {{ b.domain }}.{% else %}Not the official website.{% endif %}</p>
  </div>
</footer>
<div class="callbar">
  {% if b.phone %}<a class="btn call" href="tel:{{ b.phone_digits }}">Call {{ b.phone }}</a>{% endif %}
  <a class="btn {{ 'req' if b.phone else 'call' }}" href="#contact">Request</a>
</div>
{% endblock %}
