<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive">
<title>Concept: {{ b.business_name }} | Tangerines Studio</title>
<meta name="description" content="Design concept prepared for {{ b.business_name }} by Tangerines Studio. Not the official website.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@300..900&display=swap" rel="stylesheet">
<style>
:root {
  --primary: {{ p.primary }};
  --primary-ink: {{ p.primary_ink }};
  --accent: {{ p.accent }};
  --accent-ink: {{ p.accent_ink }};
  --surface: {{ p.surface }};
  --ink: #18212B;
  --muted: #59636E;
  --line: #DDE3E8;
  --white: #FFFFFF;
  --max: 1140px;
  --gutter: clamp(16px, 4vw, 40px);
}
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
body { margin: 0; font-family: "Figtree", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 1.0625rem; line-height: 1.6; color: var(--ink); background: var(--white); padding-bottom: 72px; }
@media (min-width: 761px) { body { padding-bottom: 0; } }
img { display: block; max-width: 100%; }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
.wrap { width: min(var(--max), 100% - 2 * var(--gutter)); margin-inline: auto; }
h1, h2, h3 { line-height: 1.1; letter-spacing: -0.02em; margin: 0; text-wrap: balance; }

.concept-note { background: #111A22; color: #E8EDF1; font-size: 0.85rem; padding: 8px var(--gutter); text-align: center; }
.concept-note strong { color: #FFFFFF; font-weight: 700; }

.top { position: sticky; top: 0; z-index: 20; background: var(--white); border-bottom: 1px solid var(--line); }
.top .wrap { display: flex; align-items: center; gap: 24px; min-height: 72px; }
.logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; font-size: 1.2rem; letter-spacing: -0.01em; color: var(--primary); }
.logo img { max-height: 48px; width: auto; }
.menu { display: flex; gap: 22px; margin-left: auto; }
.menu a { text-decoration: none; color: var(--muted); font-weight: 600; font-size: 0.98rem; }
.menu a:hover { color: var(--ink); }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px; padding: 0 24px; border-radius: 10px; font-weight: 750; text-decoration: none; font-size: 1.02rem; white-space: nowrap; border: 2px solid transparent; }
.btn svg { width: 18px; height: 18px; flex: none; }
.btn-accent { background: var(--accent); color: var(--accent-ink); }
.btn-ghost { background: transparent; color: var(--primary-ink); border-color: rgba(255,255,255,0.55); }
.btn-primary { background: var(--primary); color: var(--primary-ink); }
.top .btn { min-height: 44px; padding: 0 18px; }
@media (max-width: 760px) { .menu { display: none; } .top .btn { margin-left: auto; } }
@media (max-width: 420px) { .top .btn span { display: none; } }

.hero { background: var(--primary); color: var(--primary-ink); padding: clamp(44px, 7vw, 88px) 0; }
.hero .wrap { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(28px, 5vw, 56px); align-items: center; }
.hero h1 { font-size: clamp(2.3rem, 1.4rem + 3.6vw, 3.9rem); font-weight: 850; line-height: 1.04; }
.hero p.sub { font-size: 1.2rem; opacity: 0.88; margin: 18px 0 28px; max-width: 34em; }
.hero .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
.facts { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-weight: 650; font-size: 0.98rem; }
.facts li { display: flex; align-items: center; gap: 8px; }
.facts svg { width: 18px; height: 18px; flex: none; color: var(--accent); }
.hero-card { background: var(--white); color: var(--ink); border-radius: 16px; padding: 26px; box-shadow: 0 18px 40px rgba(0,0,0,0.18); }
.hero-photo { border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 3; background: rgba(255,255,255,0.08); }
.hero-photo img { width: 100%; height: 100%; object-fit: cover; }
.hero-card h2 { font-size: 1.25rem; margin-bottom: 12px; }
.hours { width: 100%; border-collapse: collapse; font-size: 0.98rem; }
.hours td { padding: 7px 0; border-bottom: 1px solid var(--line); }
.hours td:last-child { text-align: right; font-weight: 650; }
.hero-card .area { margin: 16px 0 0; color: var(--muted); font-size: 0.95rem; }
@media (max-width: 900px) { .hero .wrap { grid-template-columns: 1fr; } }

section { padding: clamp(52px, 8vw, 96px) 0; }
.alt { background: var(--surface); }
.head { max-width: 40em; margin-bottom: 36px; }
.head h2 { font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem); font-weight: 820; color: var(--primary); }
.head p { color: var(--muted); font-size: 1.12rem; margin: 12px 0 0; }

.services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.service { background: var(--white); border: 1px solid var(--line); border-top: 4px solid var(--accent); border-radius: 14px; padding: 22px 24px 24px; }
.service h3 { font-size: 1.2rem; font-weight: 780; margin-bottom: 8px; }
.service p { margin: 0; color: var(--muted); }
@media (max-width: 900px) { .services { grid-template-columns: 1fr 1fr; } }
@media (max-width: 560px) { .services { grid-template-columns: 1fr; } }

.about .wrap { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
.about p { margin: 0 0 16px; font-size: 1.1rem; }
.points { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
.points li { background: var(--surface); border-radius: 12px; padding: 16px 18px; font-weight: 650; display: flex; gap: 12px; align-items: flex-start; }
.points svg { width: 20px; height: 20px; flex: none; color: var(--primary); margin-top: 2px; }
@media (max-width: 900px) { .about .wrap { grid-template-columns: 1fr; } }

.reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
.review { margin: 0; background: var(--white); border: 1px solid var(--line); border-radius: 14px; padding: 24px; }
.review blockquote { margin: 0 0 14px; font-size: 1.05rem; }
.review figcaption { color: var(--muted); font-weight: 650; font-size: 0.95rem; }
.source-note { margin: 16px 0 0; color: var(--muted); font-size: 0.9rem; }

.contact .wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(28px, 5vw, 64px); }
.contact dl { margin: 0; display: grid; gap: 18px; }
.contact dt { color: var(--muted); font-size: 0.92rem; font-weight: 650; }
.contact dd { margin: 2px 0 0; font-size: 1.15rem; font-weight: 700; }
.contact dd a { text-decoration-color: var(--accent); text-underline-offset: 4px; }
.form { background: var(--surface); border-radius: 16px; padding: clamp(22px, 3vw, 32px); }
.form label { display: block; font-weight: 650; font-size: 0.95rem; margin: 0 0 6px; }
.form input, .form textarea { width: 100%; font: inherit; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--line); background: var(--white); margin-bottom: 14px; color: var(--muted); }
.form textarea { min-height: 96px; resize: vertical; }
.form .btn { width: 100%; opacity: 0.6; cursor: not-allowed; }
.form .form-note { margin: 12px 0 0; font-size: 0.9rem; color: var(--muted); }
@media (max-width: 900px) { .contact .wrap { grid-template-columns: 1fr; } }

.foot { background: #111A22; color: #C9D2DA; padding: 36px 0 44px; font-size: 0.95rem; }
.foot .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; }
.foot strong { color: #FFFFFF; }
.foot p { margin: 0; }

.callbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; gap: 10px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: var(--white); border-top: 1px solid var(--line); }
.callbar .btn { flex: 1; min-height: 48px; }
@media (min-width: 761px) { .callbar { display: none; } }
</style>
</head>
<body>
<div class="concept-note" role="note"><strong>Concept for {{ b.business_name }} by Tangerines Studio.</strong> Not the official website.</div>

<header class="top">
  <div class="wrap">
    <a class="logo" href="#top">{% if b.logo_url %}<img src="{{ b.logo_url }}" alt="{{ b.business_name }}">{% else %}{{ b.business_name }}{% endif %}</a>
    <nav class="menu" aria-label="Main">
      <a href="#services">Services</a>
      <a href="#about">About</a>
      {% if b.reviews %}<a href="#reviews">Reviews</a>{% endif %}
      <a href="#contact">Contact</a>
    </nav>
    {% if b.phone %}<a class="btn btn-accent" href="tel:{{ b.phone_digits }}">{{ icon_phone|safe }}<span>{{ b.phone }}</span></a>{% endif %}
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>{{ b.hero_title }}</h1>
        <p class="sub">{{ b.hero_sub }}</p>
        <div class="ctas">
          {% if b.phone %}<a class="btn btn-accent" href="tel:{{ b.phone_digits }}">{{ icon_phone|safe }}Call {{ b.phone }}</a>{% endif %}
          {% if b.email %}<a class="btn btn-ghost" href="mailto:{{ b.email }}">Email us</a>{% endif %}
        </div>
        {% if b.facts %}<ul class="facts">{% for f in b.facts[:3] %}<li>{{ icon_check|safe }}{{ f }}</li>{% endfor %}</ul>{% endif %}
      </div>
      {% if b.hero_image_url %}
      <div class="hero-photo"><img src="{{ b.hero_image_url }}" alt="{{ b.hero_image_alt or b.business_name }}"></div>
      {% else %}
      <div class="hero-card">
        <h2>{% if b.hours %}Hours{% else %}Where we work{% endif %}</h2>
        {% if b.hours %}<table class="hours">{% for h in b.hours %}<tr><td>{{ h.days }}</td><td>{{ h.time }}</td></tr>{% endfor %}</table>{% endif %}
        {% if b.service_area %}<p class="area">Serving {{ b.service_area|join(', ') }}.</p>{% endif %}
      </div>
      {% endif %}
    </div>
  </section>

  <section class="alt" id="services">
    <div class="wrap">
      <div class="head">
        <h2>{{ b.services_title or 'What we do' }}</h2>
        {% if b.services_intro %}<p>{{ b.services_intro }}</p>{% endif %}
      </div>
      <div class="services">
        {% for s in b.services %}
        <article class="service">
          <h3>{{ s.name }}</h3>
          {% if s.text %}<p>{{ s.text }}</p>{% endif %}
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="wrap">
      <div>
        <div class="head"><h2>{{ b.about_title or 'About us' }}</h2></div>
        {% for para in b.about %}<p>{{ para }}</p>{% endfor %}
      </div>
      {% if b.facts %}
      <ul class="points">{% for f in b.facts %}<li>{{ icon_check|safe }}{{ f }}</li>{% endfor %}</ul>
      {% endif %}
    </div>
  </section>

  {% if b.reviews %}
  <section class="alt" id="reviews">
    <div class="wrap">
      <div class="head"><h2>What customers say</h2></div>
      <div class="reviews">
        {% for r in b.reviews %}
        <figure class="review"><blockquote>{{ r.quote }}</blockquote><figcaption>{{ r.name }}</figcaption></figure>
        {% endfor %}
      </div>
      {% if b.reviews_source %}<p class="source-note">Quoted from {{ b.reviews_source }}.</p>{% endif %}
    </div>
  </section>
  {% endif %}

  <section class="contact{% if not b.reviews %} alt{% endif %}" id="contact">
    <div class="wrap">
      <div>
        <div class="head"><h2>Get in touch</h2></div>
        <dl>
          {% if b.phone %}<div><dt>Phone</dt><dd><a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a></dd></div>{% endif %}
          {% if b.email %}<div><dt>Email</dt><dd><a href="mailto:{{ b.email }}">{{ b.email }}</a></dd></div>{% endif %}
          {% if b.address %}<div><dt>Address</dt><dd>{{ b.address }}</dd></div>{% endif %}
          {% if b.service_area %}<div><dt>Service area</dt><dd>{{ b.service_area|join(', ') }}</dd></div>{% endif %}
        </dl>
      </div>
      <form class="form" aria-label="Contact form preview" onsubmit="return false">
        <label for="f-name">Name</label><input id="f-name" type="text" disabled placeholder="Your name">
        <label for="f-phone">Phone</label><input id="f-phone" type="tel" disabled placeholder="Best number to reach you">
        <label for="f-msg">How can we help?</label><textarea id="f-msg" disabled placeholder="Tell us what's going on"></textarea>
        <button class="btn btn-primary" type="button" disabled>Send request</button>
        <p class="form-note">This form switches on when the site goes live. Requests will go straight to your inbox.</p>
      </form>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap">
    <p><strong>{{ b.business_name }}</strong>{% if b.address %}<br>{{ b.address }}{% endif %}</p>
    <p>Concept prepared by Tangerines Studio. Not the official website.</p>
  </div>
</footer>

{% if b.phone %}
<div class="callbar">
  <a class="btn btn-accent" href="tel:{{ b.phone_digits }}">{{ icon_phone|safe }}Call now</a>
  {% if b.email %}<a class="btn btn-primary" href="mailto:{{ b.email }}">Email</a>{% endif %}
</div>
{% endif %}
</body>
</html>
