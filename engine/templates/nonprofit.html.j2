{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{# Nonprofit theme. Warm, civic, hopeful: cream paper, civic blue, a mint accent. Matches /work/harvest-table-pantry/
   Donate and volunteer buttons always link out to the page the organization already uses; nothing is collected here. #}
{% block fontpreload %}<link rel="preload" href="{{ root }}fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ root }}fonts/public-sans.woff2" as="font" type="font/woff2" crossorigin>{% endblock %}
{% block css %}
@font-face{font-family:"Fraunces";src:url({{ root }}fonts/fraunces.woff2) format("woff2");font-weight:100 900;font-display:swap}
@font-face{font-family:"Public Sans";src:url({{ root }}fonts/public-sans.woff2) format("woff2");font-weight:100 900;font-display:swap}
:root{--bg:{{ p.bg }};--tint:{{ p.tint }};--ink:{{ p.ink }};--ink2:{{ p.ink2 }};--green:{{ p.accent_text }};--line:{{ p.line }};--paper:{{ p.paper or "#FFFFFF" }};--main:{{ p.main }};--main2:{{ p.main2 }};--accent:{{ p.accent }};--deep:{{ p.deep }}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;font-family:"Public Sans",system-ui,sans-serif;font-size:1.0625rem;line-height:1.65;color:var(--ink);background:var(--bg)}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-underline-offset:.2em}
:focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:3px}
.on-dark :focus-visible{outline-color:#fff}
.wrap{max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,64px)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:84px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;min-width:0}
.brand svg{flex:none}
.brand .name{font-family:"Fraunces",serif;font-size:1.375rem;font-weight:600;letter-spacing:-.01em;line-height:1.05}
.brand .name i{font-style:normal;font-family:"Public Sans",sans-serif;font-size:.8125rem;font-weight:500;display:block;margin-top:4px;color:var(--ink2);letter-spacing:0}
.brand .logo{height:56px;width:auto;max-width:240px;object-fit:contain}
nav.main ul{display:flex;gap:28px;list-style:none;margin:0;padding:0}
nav.main a{text-decoration:none;font-size:.9375rem;font-weight:500}
nav.main a:hover,nav.main a[aria-current]{text-decoration:underline;text-decoration-thickness:2px;text-decoration-color:var(--accent)}
.top-cta{display:flex;align-items:center;gap:20px}
.top-cta .quiet{font-weight:600;text-decoration:none;white-space:nowrap}
.top-cta .quiet:hover{text-decoration:underline}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:600;text-decoration:none;padding:14px 24px;border-radius:10px;font-size:1rem;line-height:1.2;white-space:nowrap}
.btn.dark{background:var(--main);color:#fff}
.btn.dark:hover{background:var(--main2)}
.btn.line{border:1.5px solid var(--main);color:var(--main);background:transparent}
.btn.line:hover{background:var(--main);color:#fff}
.btn.light{background:#fff;color:var(--main)}
.btn.light:hover{background:var(--tint)}
.btn .out{font-size:.875em;line-height:1}
.hero{padding:clamp(32px,5vw,72px) 0 clamp(64px,8vw,112px)}
.hero-grid{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:clamp(32px,6vw,88px);align-items:center}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:.875rem;font-weight:600;color:var(--green);margin:0 0 24px}
.eyebrow:before{content:"";flex:none;width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 35%,transparent)}
h1,h2,h3{font-family:"Fraunces",serif;letter-spacing:-.015em}
h1{font-weight:500;font-size:clamp(2.6rem,5.4vw,4.75rem);line-height:1.04;margin:0 0 28px}
h1.mid{font-size:clamp(2.3rem,4.4vw,3.9rem);line-height:1.06}
h1.long{font-size:clamp(2rem,3.6vw,3.1rem);line-height:1.1}
.lede{font-size:1.1875rem;max-width:42ch;color:var(--ink2);margin:0 0 34px}
.actions{display:flex;flex-wrap:wrap;gap:12px}
.hero-photo{margin:0;position:relative}
.hero-photo img{width:100%;aspect-ratio:5/6;object-fit:cover;object-position:{{ b.hero_image_position or "50% 40%" }};border-radius:28px}
.stamp{position:absolute;left:-28px;bottom:32px;max-width:250px;background:var(--paper);border-radius:16px;padding:18px 20px;box-shadow:0 20px 40px -24px rgba(20,30,50,.45)}
.stamp p{margin:0;font-family:"Fraunces",serif;font-size:1.1875rem;line-height:1.3;font-weight:500}
.stamp span{display:block;font-size:.8125rem;font-weight:600;color:var(--green);margin-bottom:4px;font-family:"Public Sans",sans-serif}
.hero.type{background:var(--tint);padding:clamp(56px,8vw,120px) 0 0;overflow:hidden}
.hero.type h1{max-width:20ch;font-size:clamp(2.8rem,6.4vw,5.6rem)}
.hero.type h1.mid{font-size:clamp(2.5rem,5.2vw,4.5rem)}
.hero.type h1.long{font-size:clamp(2.1rem,4vw,3.4rem)}
.ways{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:clamp(48px,6vw,80px);border-top:1.5px solid var(--main)}
.ways>div{padding:24px 28px 40px 0}
.ways>div+div{padding-left:28px;border-left:1px solid #CFC2AA}
.ways h2{font-size:1.5rem;font-weight:600;margin:0 0 8px}
.ways p{margin:0 0 18px;color:var(--ink2);max-width:32ch}
.ways a.more{font-weight:600}
.ways dl{margin:0}
.ways dl div{display:flex;justify-content:space-between;gap:12px;padding:6px 0;border-bottom:1px solid #CFC2AA;font-size:.9375rem}
.ways dd{margin:0;font-weight:600;text-align:right}
section{padding:clamp(72px,9vw,128px) 0}
h2{font-weight:500;font-size:clamp(2.1rem,4vw,3.25rem);line-height:1.08;margin:0 0 18px}
.intro{max-width:48ch;color:var(--ink2);margin:0}
.facts{background:var(--main);color:#fff}
.facts ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat({{ b.facts|length or 1 }},minmax(0,1fr));gap:clamp(24px,4vw,56px)}
.facts li{border-top:2px solid var(--accent);padding-top:20px;font-family:"Fraunces",serif;font-size:clamp(1.25rem,2vw,1.5rem);line-height:1.3;font-weight:500}
.mission{background:var(--bg)}
.mission-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,7vw,112px);align-items:start}
.mission blockquote{margin:0;font-family:"Fraunces",serif;font-style:italic;font-weight:400;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.25;color:var(--main);border-left:3px solid var(--accent);padding-left:clamp(20px,3vw,32px)}
.mission blockquote p{margin:0}
.about-img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:20px;margin-top:40px}
.mission .body p{margin:0 0 18px;max-width:56ch}
.mission .body p.lead{font-size:1.25rem;line-height:1.55;color:var(--ink)}
.prog-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:24px;margin-bottom:48px}
.programs{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(32px,5vw,72px);counter-reset:prog}
.programs li{display:grid;grid-template-columns:56px minmax(0,1fr);gap:12px;padding:28px 0;border-top:1px solid var(--line);counter-increment:prog}
.programs li:before{content:counter(prog,decimal-leading-zero);font-family:"Fraunces",serif;font-size:1.125rem;font-weight:600;color:var(--green);padding-top:4px}
.programs h3{font-size:1.5rem;font-weight:600;line-height:1.2;margin:0 0 8px}
.programs p{margin:0;color:var(--ink2)}
.help{background:var(--tint)}
.help-grid{display:grid;grid-template-columns:repeat({{ [((1 if b.donate_url else 0) + (1 if b.volunteer_url else 0) + 1), 3]|min }},minmax(0,1fr));gap:clamp(16px,2.5vw,28px);margin-top:44px}
.help-card{background:var(--paper);border-radius:20px;padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;align-items:flex-start}
.help-card.give{background:var(--main);color:#fff}
.help-card h3{font-size:1.75rem;font-weight:600;margin:0 0 10px}
.help-card p{margin:0 0 24px;color:var(--ink2)}
.help-card.give p{color:#D5DDEA}
.help-card .btn{margin-top:auto}
.help-card small{display:block;margin-top:12px;font-size:.8125rem;color:var(--ink2)}
.help-card.give small{color:#C3CDDC}
.quotes-sec{background:var(--bg)}
.quotes{list-style:none;margin:44px 0 0;padding:0;display:grid;grid-template-columns:repeat({{ [b.reviews|length, 3]|min }},minmax(0,1fr));gap:clamp(24px,4vw,48px)}
.quotes li{border-top:2px solid var(--accent);padding-top:24px}
.quotes blockquote{margin:0;font-family:"Fraunces",serif;font-size:1.3125rem;line-height:1.45}
.quotes blockquote p{margin:0}
.quotes cite{display:block;font-style:normal;font-weight:600;margin-top:14px;font-size:.9375rem}
.src{font-size:.9375rem;color:var(--ink2);margin:32px 0 0}
.visit-grid{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:clamp(32px,7vw,112px)}
.visit-grid.one{grid-template-columns:minmax(0,1fr);max-width:720px}
dl.hours{margin:24px 0 0;border-top:1.5px solid var(--main)}
dl.hours div{display:flex;justify-content:space-between;gap:16px;padding:15px 0;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}
dl.hours dt{font-weight:600}dl.hours dd{margin:0;color:var(--ink2);text-align:right}
.area{margin:24px 0 0;font-family:"Fraunces",serif;font-size:1.375rem;line-height:1.5}
address{font-style:normal;font-family:"Fraunces",serif;font-size:1.625rem;line-height:1.3;margin:0 0 24px}
dl.contact-list{margin:0;border-top:1px solid var(--line)}
dl.contact-list div{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid var(--line)}
dl.contact-list dt{color:var(--ink2)}
dl.contact-list dd{margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere;min-width:0}
.req{background:var(--deep);color:#fff}
.req-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,7vw,112px)}
.req .intro{color:#C9D2E0}
.req .bigtel{display:inline-block;margin-top:28px;font-family:"Fraunces",serif;font-size:clamp(1.9rem,3.4vw,2.6rem);text-decoration:none;font-variant-numeric:lining-nums tabular-nums}
.req .bigtel:hover{text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:1px}
.req .mail{display:block;margin-top:12px;overflow-wrap:anywhere}
form{background:var(--bg);color:var(--ink);border-radius:20px;padding:clamp(24px,3.5vw,44px)}
.note{background:var(--tint);border-radius:10px;padding:12px 16px;font-size:.9375rem;margin:0 0 24px}
fieldset{border:0;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:18px;min-width:0}
label{display:block;font-weight:600;font-size:.9375rem}
.full{grid-column:1/-1}
input,select,textarea{display:block;width:100%;margin-top:6px;font:inherit;font-size:1rem;padding:12px 14px;border:1px solid #A9A08F;border-radius:8px;background:#F4EFE5;color:var(--ink)}
textarea{min-height:110px}
form button{margin-top:22px;font:inherit;font-weight:600;background:var(--main);color:#fff;border:0;border-radius:10px;padding:14px 24px;cursor:pointer}
form button:hover{background:var(--main2)}
form button[disabled]{background:#6F7685;color:#fff;cursor:not-allowed}
.form-done{background:var(--bg);color:var(--ink);border-radius:20px;padding:clamp(24px,3.5vw,44px)}
.form-done p{margin:0 0 8px}
.page-hero{padding-bottom:clamp(40px,5vw,72px)}
.page-hero h1{max-width:18ch}
.prose{max-width:860px}
.prose.with-img{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(32px,7vw,112px);max-width:none;align-items:center}
.prose p{max-width:60ch;margin:0 0 18px}
.prose .programs{margin-top:28px;grid-template-columns:1fr}
.prose-img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:20px}
.prose-sec+.prose-sec{padding-top:0}
.gallery{list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.gallery img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:16px}
footer{padding:48px 0 56px;font-size:.9375rem;color:var(--ink2)}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px;border-top:1px solid var(--line);padding-top:32px}
.foot p{margin:0}
.callbar{display:none}
@media (max-width:1000px){
  nav.main{display:none}
  .hero-grid,.mission-grid,.visit-grid,.req-grid,.prose.with-img{grid-template-columns:1fr}
  .hero-photo{max-width:560px}
  .stamp{left:16px}
  .ways,.help-grid{grid-template-columns:1fr}
  .ways>div,.ways>div+div{padding:22px 0 26px;border-left:0;border-bottom:1px solid #CFC2AA}
  .programs,.gallery{grid-template-columns:1fr 1fr}
  .facts ul,.quotes{grid-template-columns:1fr}
}
@media (max-width:760px){
  .bar{min-height:72px}
  .top-cta{display:none}
  .brand .name{font-size:1.1875rem}
  .brand .logo{height:46px;max-width:200px}
  .hero-photo img{aspect-ratio:4/3;border-radius:20px}
  .stamp{position:static;max-width:none;margin:-36px 16px 0;position:relative}
  .programs{grid-template-columns:1fr}
  .programs li{grid-template-columns:44px minmax(0,1fr)}
  fieldset{grid-template-columns:1fr}
  .callbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:20;gap:10px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:var(--bg);border-top:1px solid var(--line)}
  .callbar .btn{flex:1;padding:14px 10px}
  footer{padding-bottom:110px}
}
{% endblock %}
{% block body %}
{% set contact_href = contact_href or "#contact" %}
{% macro out(url, label, cls) %}<a class="btn {{ cls }}" href="{{ url }}" rel="noopener">{{ label }}<span class="out" aria-hidden="true">&#8599;</span></a>{% endmacro %}
{% macro host(url) %}{{ url.split("//")[-1].split("/")[0].replace("www.", "") }}{% endmacro %}
{% macro sec_services() %}
  <section id="services" aria-labelledby="prog-title">
    <div class="wrap">
      <div class="prog-head">
        <div>
          <p class="eyebrow">{{ b.services_label or "What we do" }}</p>
          <h2 id="prog-title">{{ b.services_title or "Our programs" }}</h2>
          {% if b.services_intro %}<p class="intro">{{ b.services_intro }}</p>{% endif %}
        </div>
      </div>
      <ul class="programs">
        {% for s in b.services %}<li><div><h3>{{ s.name }}</h3>{% if s.text %}<p>{{ s.text }}</p>{% endif %}</div></li>{% endfor %}
      </ul>
    </div>
  </section>

{% endmacro %}
{% macro sec_about() %}
  <section id="about" class="mission" aria-labelledby="about-title">
    <div class="wrap mission-grid">
      <div>
        <p class="eyebrow">{{ "Our mission" if b.mission else "About us" }}</p>
        <h2 id="about-title">{{ b.about_title or ("About " ~ b.business_name) }}</h2>
        {% if b.mission %}<blockquote><p>{{ b.mission }}</p></blockquote>{% endif %}
      </div>
      <div class="body">
        {% for para in b.about %}<p{% if loop.first %} class="lead"{% endif %}>{{ para }}</p>{% endfor %}
        {% if b.about_image_url %}{{ m.img(b.about_image_url, b.about_image_alt or ("Photo from " ~ b.business_name), "(max-width:1000px) 90vw, 55vw", root=root, cls="about-img") }}{% endif %}
      </div>
    </div>
  </section>

{% endmacro %}
{% macro sec_help() %}
  {% if b.donate_url or b.volunteer_url %}
  <section id="help" class="help" aria-labelledby="help-title">
    <div class="wrap">
      <p class="eyebrow">Get involved</p>
      <h2 id="help-title">{{ b.help_title or "How you can help" }}</h2>
      {% if b.help_intro %}<p class="intro">{{ b.help_intro }}</p>{% endif %}
      <div class="help-grid">
        {% if b.donate_url %}
        <div class="help-card give on-dark">
          <h3>{{ b.donate_title or "Give" }}</h3>
          <p>{{ b.donate_text or ("Your gift goes to the work of " ~ b.business_name ~ ".") }}</p>
          {{ out(b.donate_url, b.donate_label or "Donate", "light") }}
          <small>Opens {{ host(b.donate_url) }}{% if b.donate_note %}. {{ b.donate_note }}{% endif %}</small>
        </div>
        {% endif %}
        {% if b.volunteer_url %}
        <div class="help-card">
          <h3>{{ b.volunteer_title or "Volunteer" }}</h3>
          <p>{{ b.volunteer_text or "Give your time. Sign up on our volunteer page." }}</p>
          {{ out(b.volunteer_url, b.volunteer_label or "Volunteer with us", "dark") }}
          <small>Opens {{ host(b.volunteer_url) }}</small>
        </div>
        {% endif %}
        <div class="help-card">
          <h3>{{ b.ask_title or "Ask us" }}</h3>
          <p>{{ b.ask_text or "Questions about our work, or about getting help? Get in touch." }}</p>
          <a class="btn line" href="{{ contact_href }}">{{ b.cta_label or "Contact us" }}</a>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

{% endmacro %}
{% macro sec_reviews() %}
  {% if b.reviews %}
  <section class="quotes-sec" aria-labelledby="rev-title">
    <div class="wrap">
      <h2 id="rev-title">{{ b.reviews_title or "In their words" }}</h2>
      <ul class="quotes">
        {% for r in b.reviews %}<li><blockquote><p>&ldquo;{{ r.quote }}&rdquo;</p></blockquote><cite>{{ r.name }}</cite></li>{% endfor %}
      </ul>
      <p class="src">Quoted word for word from {{ b.reviews_source }}.</p>
    </div>
  </section>
  {% endif %}

{% endmacro %}
{% macro sec_visit() %}
  {% if b.hours or b.address or b.service_area %}
  <section id="visit" aria-labelledby="visit-title">
    <div class="wrap visit-grid{% if not (b.hours and b.address) %} one{% endif %}">
      {% if b.hours or b.service_area %}
      <div>
        <h2 id="visit-title">{% if b.hours %}{{ b.hours_title or "When we're open" }}{% else %}Where we work{% endif %}</h2>
        {% if b.hours_note %}<p class="intro">{{ b.hours_note }}</p>{% endif %}
        {% if b.hours %}<dl class="hours">{% for h in b.hours %}<div><dt>{{ h.days }}</dt><dd>{{ h.time }}</dd></div>{% endfor %}</dl>{% endif %}
        {% if b.service_area %}<p class="area">Serving {{ b.service_area | join(", ") }}</p>{% endif %}
      </div>
      {% endif %}
      {% if b.address %}
      <div>
        {% if b.hours or b.service_area %}<h2>Find us</h2>{% else %}<h2 id="visit-title">Find us</h2>{% endif %}
        <address>{{ b.business_name }}<br>{{ b.address }}</address>
        <dl class="contact-list">
          {% if b.phone %}<div><dt>Phone</dt><dd><a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a></dd></div>{% endif %}
          {% if b.email %}<div><dt>Email</dt><dd><a href="mailto:{{ b.email }}">{{ b.email }}</a></dd></div>{% endif %}
          {% if b.map_url %}<div><dt>Directions</dt><dd><a href="{{ b.map_url }}" rel="noopener">Open in maps</a></dd></div>{% endif %}
        </dl>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

{% endmacro %}
{% macro sec_contact() %}
  <section id="contact" class="req on-dark" aria-labelledby="req-title">
    <div class="wrap req-grid">
      <div>
        <h2 id="req-title">{{ b.contact_title or "Contact us" }}</h2>
        <p class="intro">{{ b.contact_text or ("Call or send a message." if b.phone else "Send an email or a message.") }}</p>
        {% if b.phone %}<a class="bigtel" href="tel:{{ b.phone_digits }}">{{ b.phone }}</a>{% endif %}
        {% if b.email %}<a class="mail" href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}
      </div>
      {% if mode in ("preview", "sample") or b.form != false %}<div class="form-wrap">{{ m.form(b, mode, "note", "Message", service_label="What is this about?", message_label="Your message") }}</div>{% endif %}
    </div>
  </section>
{% endmacro %}
{% macro sec_text(s) %}
  <section class="prose-sec" aria-labelledby="t-{{ s.id }}">
    <div class="wrap"><div class="prose{% if s.image %} with-img{% endif %}">
      <div>
        {% if s.label %}<p class="eyebrow">{{ s.label }}</p>{% endif %}
        <h2 id="t-{{ s.id }}">{{ s.heading }}</h2>
        {% for para in s.paragraphs or [] %}<p>{{ para }}</p>{% endfor %}
        {% if s.get("items") %}<ul class="programs">{% for it in s.get("items") %}<li><div><h3>{{ it.name }}</h3>{% if it.text %}<p>{{ it.text }}</p>{% endif %}</div></li>{% endfor %}</ul>{% endif %}
      </div>
      {% if s.image %}<div>{{ m.img(s.image, s.image_alt or ("Photo from " ~ b.business_name), "(max-width:1000px) 90vw, 45vw", root=root, cls="prose-img") }}</div>{% endif %}
    </div></div>
  </section>
{% endmacro %}
{% macro sec_gallery(s) %}
  <section class="gallery-sec" aria-labelledby="g-{{ s.id }}">
    <div class="wrap">
      <h2 id="g-{{ s.id }}">{{ s.heading or "Our work" }}</h2>
      {% if s.intro %}<p class="intro">{{ s.intro }}</p>{% endif %}
      <ul class="gallery">{% for g in s.images %}<li>{{ m.img(g, g.alt or ("Photo from " ~ b.business_name), "(max-width:760px) 90vw, 33vw", root=root) }}</li>{% endfor %}</ul>
    </div>
  </section>
{% endmacro %}
<header>
  <div class="wrap bar">
    <a class="brand" href="{{ home_href or '#main' }}">
      {% if b.logo_url %}
      <img class="logo" src="{{ root }}{{ b.logo_url.src }}" width="{{ b.logo_url.width }}" height="{{ b.logo_url.height }}" alt="{{ b.business_name }}{% if page %}, home{% endif %}">
      {% else %}
      <svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><circle cx="23" cy="23" r="21.5" fill="{{ p.main }}"/><circle cx="23" cy="23" r="17.5" fill="none" stroke="{{ p.accent }}" stroke-width="1"/><text x="23" y="28.5" text-anchor="middle" font-family="Fraunces,Georgia,serif" font-weight="600" font-size="{{ 16 if b.initials|length < 2 else 15 }}" fill="#fff">{{ b.initials }}</text></svg>
      <span class="name">{{ b.wm_main }}{% if b.wm_sub %}<i>{{ b.wm_sub }}</i>{% endif %}</span>
      {% endif %}
    </a>
    <nav class="main" aria-label="Main"><ul>{% for n in nav %}<li><a href="{{ n.href }}"{% if n.current %} aria-current="page"{% endif %}>{{ n.label }}</a></li>{% endfor %}</ul></nav>
    <div class="top-cta">
      {% if b.volunteer_url %}<a class="quiet" href="{{ b.volunteer_url }}" rel="noopener">{{ b.volunteer_label or "Volunteer" }}</a>{% endif %}
      {% if b.donate_url %}{{ out(b.donate_url, b.donate_label or "Donate", "dark") }}{% else %}<a class="btn dark" href="{{ contact_href }}">{{ b.cta_label or "Contact us" }}</a>{% endif %}
    </div>
  </div>
</header>
<main id="main">
  {% if page %}
  <section class="hero page-hero" aria-labelledby="hero-title">
    <div class="wrap">
      {% if page.label %}<p class="eyebrow">{{ page.label }}</p>{% endif %}
      <h1 id="hero-title">{{ page.heading or page.title }}</h1>
      {% if page.intro %}<p class="lede">{{ page.intro }}</p>{% endif %}
    </div>
  </section>
  {% for s in page.sections %}
  {% if s.type == "services" %}{{ sec_services() }}{% elif s.type == "about" %}{{ sec_about() }}{% elif s.type == "help" %}{{ sec_help() }}{% elif s.type == "reviews" %}{{ sec_reviews() }}{% elif s.type == "visit" %}{{ sec_visit() }}{% elif s.type == "contact" %}{{ sec_contact() }}{% elif s.type == "gallery" %}{{ sec_gallery(s) }}{% else %}{{ sec_text(s) }}{% endif %}
  {% endfor %}
  {% else %}
  {% if b.hero_image_url %}
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        {% if b.kicker or b.city %}<p class="eyebrow">{{ b.kicker or b.city }}</p>{% endif %}
        <h1 id="hero-title" class="{{ b.title_size }}">{{ b.hero_title }}</h1>
        <p class="lede">{{ b.hero_sub }}</p>
        <div class="actions">
          {% if b.donate_url %}{{ out(b.donate_url, b.donate_label or "Donate", "dark") }}{% endif %}
          {% if b.volunteer_url %}{{ out(b.volunteer_url, b.volunteer_label or "Volunteer", "line") }}{% endif %}
          {% if not (b.donate_url or b.volunteer_url) %}<a class="btn dark" href="{{ contact_href }}">{{ b.cta_label or "Contact us" }}</a>{% endif %}
        </div>
      </div>
      <figure class="hero-photo">
        {{ m.img(b.hero_image_url, b.hero_image_alt or ("Photo from " ~ b.business_name), "(max-width:1000px) 90vw, 46vw", eager=True, root=root) }}
        {% if b.hours %}<figcaption class="stamp"><span>{{ b.hours_title or "When we're open" }}</span><p>{{ b.hours[0].days }}, {{ b.hours[0].time }}</p></figcaption>
        {% elif b.facts %}<figcaption class="stamp"><span>{{ b.city or "At a glance" }}</span><p>{{ b.facts[0] }}</p></figcaption>{% endif %}
      </figure>
    </div>
  </section>
  {% else %}
  <section class="hero type" aria-labelledby="hero-title">
    <div class="wrap">
      {% if b.kicker or b.city %}<p class="eyebrow">{{ b.kicker or b.city }}</p>{% endif %}
      <h1 id="hero-title" class="{{ b.title_size }}">{{ b.hero_title }}</h1>
      <p class="lede">{{ b.hero_sub }}</p>
      <div class="ways">
        <div>
          <h2>{{ b.donate_title or "Give" }}</h2>
          {% if b.donate_url %}<p>{{ b.donate_text or "Support the work with a gift." }}</p>{{ out(b.donate_url, b.donate_label or "Donate", "dark") }}
          {% else %}<p>Ask how you can support the work.</p><a class="more" href="{{ contact_href }}">Contact us</a>{% endif %}
        </div>
        <div>
          <h2>{{ b.volunteer_title or "Volunteer" }}</h2>
          {% if b.volunteer_url %}<p>{{ b.volunteer_text or "Give your time." }}</p>{{ out(b.volunteer_url, b.volunteer_label or "Volunteer", "line") }}
          {% else %}<p>Ask about ways to help.</p><a class="more" href="{{ contact_href }}">Get in touch</a>{% endif %}
        </div>
        <div>
          <h2>{% if b.hours %}{{ b.hours_title or "When we're open" }}{% else %}Reach us{% endif %}</h2>
          {% if b.hours %}<dl>{% for h in b.hours[:4] %}<div><dt>{{ h.days }}</dt><dd>{{ h.time }}</dd></div>{% endfor %}</dl>
          {% else %}<p>{% if b.phone %}<a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a><br>{% endif %}{% if b.email %}<a href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}</p>{% endif %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {% if b.facts %}
  <div class="facts on-dark">
    <section style="padding:clamp(48px,6vw,80px) 0" aria-label="At a glance">
      <div class="wrap"><ul>{% for f in b.facts %}<li>{{ f }}</li>{% endfor %}</ul></div>
    </section>
  </div>
  {% endif %}

  {{ sec_about() }}
  {{ sec_services() }}
  {{ sec_help() }}
  {{ sec_reviews() }}
  {{ sec_visit() }}
  {{ sec_contact() }}
  {% endif %}
</main>
<footer>
  <div class="wrap foot">
    <p>{{ b.business_name }}{% if b.address %}<br>{{ b.address }}{% endif %}{% if b.registration %}<br>{{ b.registration }}{% endif %}</p>
    <p>{% if b.phone %}<a href="tel:{{ b.phone_digits }}">{{ b.phone }}</a><br>{% endif %}{% if b.email %}<a href="mailto:{{ b.email }}">{{ b.email }}</a>{% endif %}</p>
    <p>{{ m.footer_credit(b, mode) }}</p>
  </div>
</footer>
<div class="callbar">
  {% if b.donate_url %}{{ out(b.donate_url, b.donate_label or "Donate", "dark") }}{% elif b.phone %}<a class="btn dark" href="tel:{{ b.phone_digits }}">Call</a>{% endif %}
  {% if b.volunteer_url %}{{ out(b.volunteer_url, b.volunteer_label or "Volunteer", "line") }}{% else %}<a class="btn line" href="{{ contact_href }}">Contact</a>{% endif %}
</div>
{% endblock %}
